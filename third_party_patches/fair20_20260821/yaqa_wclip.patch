+FORMAL_CALIBRATION_ARTIFACTS = {
+    "Qwen3-0.6B": (
+        Path(
+            "/minimax-avatar-new/zhangqian/realq/experiment_data/"
+            "realq_20group_20260808/shared_cache/qwen3-0.6b/tokens/"
+            "Qwen3-0.6B_wikitext2_train_n256_sl2048_seed1.pt"
+        ).resolve(),
+        "aed4e972d31207526d57a4bb62414c24b6c92ff51eda1fa9d70c36c1dfea5d34",
+    ),
+    "Llama-3.1-8B-Instruct": (
+        Path(
+            "/minimax-avatar-new/zhangqian/realq/experiment_data/"
+            "realq_20group_20260808/shared_cache/llama31-8b-instruct/tokens/"
+            "Llama-3.1-8B-Instruct_wikitext2_train_n256_sl2048_seed1.pt"
+        ).resolve(),
+        "8030125e31c8738d6cea839d9afd5252617acf9517a226b56ebd1c69804be95e",
+    ),
+    "Qwen3-4B": (
+        Path(
+            "/minimax-avatar-new/zhangqian/realq/experiment_data/"
+            "realq_20group_20260808/shared_cache/qwen3-4b/tokens/"
+            "Qwen3-4B_wikitext2_train_n256_sl2048_seed1.pt"
+        ).resolve(),
+        "21210e1929aa90ea23572e7904f8ebda7b3af75ebf8d9037e8196b3d2c52a399",
+    ),
+    "Qwen3-8B": (
+        Path(
+            "/minimax-avatar-new/zhangqian/realq/experiment_data/"
+            "realq_20group_20260808/shared_cache/qwen3-8b/tokens/"
+            "Qwen3-8B_wikitext2_train_n256_sl2048_seed1.pt"
+        ).resolve(),
+        "a7acbd907d640eb8ab33a52153da1bf36e4eb550cbc107fe081c9bdc047d3b6f",
+    ),
+    "Qwen3-32B": (
+        Path(
+            "/minimax-avatar-new/zhangqian/realq/experiment_data/"
+            "realq_20group_20260808/shared_cache/qwen3-32b/tokens/"
+            "Qwen3-32B_wikitext2_train_n256_sl2048_seed1.pt"
+        ).resolve(),
+        "749360f8fb36a6ac91936954f61a7ec688fa8eb0b0d17a61fe4349ff6ec06364",
+    ),
+}
+PROJECTION_NAMES = frozenset({"q", "k", "v", "o", "up", "gate", "down"})
+SETTING_BITS = {
+    "W4A16KV16": 4,
+    "W3A16KV16": 3,
+    "W2A16KV16": 2,
+    "W2A4KV4": 2,
+    "W4A4KV4": 4,
+}
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def expected_akv(setting: str, layer_count: int) -> dict[str, Any]:
+    if setting not in SETTING_BITS:
+        raise ValueError(f"unsupported setting: {setting!r}")
+    aware = setting in {"W2A4KV4", "W4A4KV4"}
+    bits = 4 if aware else 16
+    return {
+        "mode": "aware" if aware else "n/a",
+        "a_bits": bits,
+        "k_bits": bits,
+        "v_bits": bits,
+        "groupsize": -1,
+        "clip_ratio": 0.9 if aware else 1.0,
+        "symmetric": True,
+        "decoder_layers": layer_count,
+        "activation_input_sites": 7 * layer_count if aware else 0,
+        "value_output_sites": layer_count if aware else 0,
+        "post_rope_k_sites": layer_count if aware else 0,
+        "query_quantized": False,
+        "extra_qk_hadamard": False,
+    }
+
+
+def calibration_contract(
+    model: str | os.PathLike[str],
+) -> tuple[Path, str]:
+    """Return the frozen model-specific WikiText2-256 token artifact."""
+
+    model_path = Path(model).resolve()
+    contract = FORMAL_CALIBRATION_ARTIFACTS.get(model_path.name)
+    if contract is not None:
+        return contract
+    # Preserve the historical Llama and temporary-test-fixture contract.
+    return TOKEN_PATH, TOKEN_SHA256
+
+
+def validate_preflight(
+    *,
+    model: str | os.PathLike[str],
+    setting: str,
+    weight_bits: int,
+    hessian_dir: str | os.PathLike[str],
+    validation_report: str | os.PathLike[str],
+    output_dir: str | os.PathLike[str],
+    require_fresh_output: bool = True,
+    expected_deterministic: bool = False,
+    expected_global_seed: int = 1,
+) -> dict[str, Any]:
+    """Validate the frozen Hessian contract and require a fresh output path."""
+
+    if setting not in SETTING_BITS:
+        raise ValueError(f"unsupported setting: {setting!r}")
+    if weight_bits != SETTING_BITS[setting]:
+        raise RuntimeError(
+            f"{setting} requires W{SETTING_BITS[setting]}, got W{weight_bits}"
+        )
+
+    model_path = Path(model).resolve()
+    hessian_path = Path(hessian_dir).resolve()
+    validation_path = Path(validation_report).resolve()
+    output_path = Path(output_dir).resolve()
+    if require_fresh_output and (
+        output_path.exists() or output_path.is_symlink()
+    ):
+        raise RuntimeError(
+            f"YAQA_wclip output must be a fresh path: {output_path}"
+        )
+    if not hessian_path.is_dir():
+        raise RuntimeError(f"Hessian directory does not exist: {hessian_path}")
+    if not validation_path.is_file():
+        raise RuntimeError(
+            f"Hessian validation report does not exist: {validation_path}"
+        )
+
+    report = json.loads(validation_path.read_text(encoding="utf-8"))
+    config = AutoConfig.from_pretrained(model_path)
+    layer_count = int(config.num_hidden_layers)
+    token_path, token_sha256 = calibration_contract(model_path)
+    if (
+        int(config.hidden_size) % 128 != 0
+        or int(config.intermediate_size) % 128 != 0
+    ):
+        raise RuntimeError(
+            "the controlled td_y=128 LDLQ path requires every projection "
+            "input dimension to be divisible by 128"
+        )
+    if (
+        report.get("schema_version") != 2
+        or report.get("status") != "validated"
+        or report.get("model") != str(model_path)
+        or Path(report.get("hessian_dir", "")).resolve() != hessian_path
+        or report.get("layer_count") != layer_count
+        or report.get("tensor_count") != 14 * layer_count
+    ):
+        raise RuntimeError("Hessian validation report header mismatch")
+
+    manifest = report.get("manifest")
+    distributed_contract = (
+        getattr(manifest, "get", lambda _key: None)("world_size"),
+        getattr(manifest, "get", lambda _key: None)(
+            "batch_size_per_rank"
+        ),
+        getattr(manifest, "get", lambda _key: None)("global_batch_size"),
+        getattr(manifest, "get", lambda _key: None)("iterations"),
+    )
+    allowed_distributed_contracts = {
+        # Historical formal YAQA_wclip Hessians.
+        (4, 2, 8, 32),
+        # Single-GPU formal Hessians.  Keeping global batch 8 preserves the
+        # exact 32 calibration batches and fake-target RNG stream.
+        (1, 8, 8, 32),
+    }
+    if distributed_contract not in allowed_distributed_contracts:
+        raise RuntimeError(
+            "Validated Hessian has an unsupported distributed contract: "
+            f"{distributed_contract!r}; expected one of "
+            f"{sorted(allowed_distributed_contracts)!r}"
+        )
+
+    expected_manifest = {
+        "schema_version": 2,
+        "model": str(model_path),
+        "save_path": str(hessian_path),
+        "calib_tokens_path": str(token_path),
+        "calib_tokens_sha256": token_sha256,
+        "n_seqs": 256,
+        "ctx_size": 2048,
+        "world_size": distributed_contract[0],
+        "batch_size_per_rank": distributed_contract[1],
+        "global_batch_size": distributed_contract[2],
+        "iterations": distributed_contract[3],
+        "start_layer": 0,
+        "end_layer": layer_count,
+        "hessian_sketch": "B",
+        "power_iters": 1,
+        "fp64_accum_effective": False,
+        "torch_float32_matmul_precision": "highest",
+        "cuda_matmul_fp32_precision": "ieee",
+        "akv": expected_akv(setting, layer_count),
+    }
+    if expected_deterministic:
+        expected_manifest["determinism"] = {
+            "enabled": True,
+            "global_seed": expected_global_seed,
+            "python_hash_seed": expected_global_seed,
+            "python_random_seed": expected_global_seed,
+            "numpy_random_seed": expected_global_seed,
+            "cublas_workspace_config": ":4096:8",
+            "torch_deterministic_algorithms": True,
+            "cudnn_benchmark": False,
+            "cudnn_deterministic": True,
+            "cuda_matmul_fp32_precision": "ieee",
+            "cudnn_allow_tf32": False,
+            "fake_target_seed_rule": "calibration_iteration_index",
+        }
+    if manifest != expected_manifest:
+        mismatches = {
+            key: (getattr(manifest, "get", lambda _key: None)(key), expected)
+            for key, expected in expected_manifest.items()
+            if not isinstance(manifest, dict)
+            or manifest.get(key) != expected
+        }
+        extras = (
+            sorted(set(manifest) - set(expected_manifest))
+            if isinstance(manifest, dict)
+            else []
+        )
+        raise RuntimeError(
+            "Validated Hessian does not match this quantization setting: "
+            f"mismatch={mismatches!r}, extra={extras!r}"
+        )
+
+    manifest_path = hessian_path / "manifest.json"
+    if not manifest_path.is_file():
+        raise RuntimeError("Hessian directory is missing manifest.json")
+    live_manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if live_manifest != manifest:
+        raise RuntimeError(
+            "Hessian manifest changed after the validation report was written"
+        )
+
+    expected_tensor_paths = {
+        hessian_path / f"{layer}_{projection}_{side}.pt"
+        for layer in range(layer_count)
+        for projection in PROJECTION_NAMES
+        for side in ("hin", "hout")
+    }
+    records = report.get("tensors")
+    if not isinstance(records, list) or len(records) != len(
+        expected_tensor_paths
+    ):
+        raise RuntimeError("Hessian validation tensor record count mismatch")
+    records_by_path = {
+        Path(record.get("path", "")).resolve(): record
+        for record in records
+        if isinstance(record, dict)
+    }
+    if set(records_by_path) != expected_tensor_paths:
+        raise RuntimeError("Hessian validation tensor path set mismatch")
+    live_tensor_paths = set(hessian_path.glob("*_h*.pt"))
+    if live_tensor_paths != expected_tensor_paths:
+        raise RuntimeError("Live Hessian tensor file set mismatch")
+    for path, record in records_by_path.items():
+        if (
+            not path.is_file()
+            or record.get("bytes") != path.stat().st_size
+            or record.get("sha256") != sha256_file(path)
+        ):
+            raise RuntimeError(
+                f"Hessian tensor changed after validation: {path}"
+            )
+    if (
+        not token_path.is_file()
+        or sha256_file(token_path) != token_sha256
+    ):
+        raise RuntimeError(
+            "the frozen 256x2048 calibration-token artifact is missing or "
+            "has changed"
+        )
+
+    return {
+        "model": str(model_path),
+        "setting": setting,
+        "weight_bits": weight_bits,
+        "hessian_dir": str(hessian_path),
+        "hessian_validation_path": str(validation_path),
+        "hessian_validation_sha256": sha256_file(validation_path),
+        "hessian_manifest_path": str(manifest_path),
+        "hessian_manifest_sha256": sha256_file(manifest_path),
+        "calib_tokens_path": manifest["calib_tokens_path"],
+        "calib_tokens_sha256": manifest["calib_tokens_sha256"],
+        "layer_count": layer_count,
+        "tensor_count": len(expected_tensor_paths),
+        "output_dir": str(output_path),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", required=True)
+    parser.add_argument(
+        "--setting",
+        required=True,
+        choices=tuple(SETTING_BITS),
+    )
+    parser.add_argument("--weight-bits", required=True, type=int)
+    parser.add_argument("--hessian-dir", required=True)
+    parser.add_argument("--validation-report", required=True)
+    parser.add_argument("--output-dir", required=True)
+    args = parser.parse_args()
+    result = validate_preflight(
+        model=args.model,
+        setting=args.setting,
+        weight_bits=args.weight_bits,
+        hessian_dir=args.hessian_dir,
+        validation_report=args.validation_report,
+        output_dir=args.output_dir,
+    )
+    print(json.dumps({"status": "ready", **result}, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
