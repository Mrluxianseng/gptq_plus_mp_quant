+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 6 ]]; then
+  echo "usage: $0 <1b|3b> <W4A16KV16|W3A16KV16|W2A4KV4> <cuda-visible-list> <hessian-dir> <hessian-validation.json> <fresh-output-dir>"
+  exit 2
+fi
+
+MODEL_SIZE=$1
+SETTING=$2
+VISIBLE_GPUS=$3
+HESSIAN_DIR=$4
+HESSIAN_VALIDATION=$5
+OUTPUT_DIR=$6
+
+WORKSPACE=${REALQ_WORKSPACE:-/minimax-avatar-new/zhangqian/realq/gptq_plus}
+PYTHON_BIN=${PYTHON_BIN:-${WORKSPACE}/.venv/bin/python}
+TOKEN_PATH=${WORKSPACE}/cache/tokens/Llama-3.2-1B_wikitext2_train_n256_sl2048_seed1.pt
+TOKEN_SHA=3090c0cae6c16fd8cd04b23f08e82a7be7d2cb4f6a7ceb995a50bc4472a9ee41
+
+case "${MODEL_SIZE}" in
+  1b) MODEL_PATH=${WORKSPACE}/modelzoo/Llama/Llama-3.2-1B ;;
+  3b) MODEL_PATH=${WORKSPACE}/modelzoo/Llama/Llama-3.2-3B ;;
+  *) echo "unsupported model size: ${MODEL_SIZE}"; exit 2 ;;
+esac
+
+case "${SETTING}" in
+  W4A16KV16)
+    W_BITS=4
+    AKV_ARGS=(
+      --a_bits 16
+      --k_bits 16
+      --v_bits 16
+      --akv_groupsize -1
+      --akv_clip_ratio 1.0
+    )
+    ;;
+  W3A16KV16)
+    W_BITS=3
+    AKV_ARGS=(
+      --a_bits 16
+      --k_bits 16
+      --v_bits 16
+      --akv_groupsize -1
+      --akv_clip_ratio 1.0
+    )
+    ;;
+  W2A4KV4)
+    W_BITS=2
+    AKV_ARGS=(
+      --a_bits 4
+      --k_bits 4
+      --v_bits 4
+      --akv_groupsize -1
+      --akv_clip_ratio 0.9
+      --akv_aware_hessian
+    )
+    ;;
+  *) echo "unsupported setting: ${SETTING}"; exit 2 ;;
+esac
+
+if [[ ! -d "${HESSIAN_DIR}" ]]; then
+  echo "Hessian directory does not exist: ${HESSIAN_DIR}"
+  exit 2
+fi
+if [[ ! -f "${HESSIAN_VALIDATION}" ]]; then
+  echo "Hessian validation report does not exist: ${HESSIAN_VALIDATION}"
+  exit 2
+fi
+if [[ ! -f "${TOKEN_PATH}" ]]; then
+  echo "calibration-token artifact does not exist: ${TOKEN_PATH}"
+  exit 2
+fi
+if [[ -e "${OUTPUT_DIR}" || -L "${OUTPUT_DIR}" ]]; then
+  echo "YAQA_wclip output must be a fresh path: ${OUTPUT_DIR}"
+  exit 2
+fi
+
+cd "${WORKSPACE}"
+export CUDA_VISIBLE_DEVICES="${VISIBLE_GPUS}"
+export PYTHONPATH="${WORKSPACE}/YAQA_wclip:${WORKSPACE}:${WORKSPACE}/YAQA_wclip/qtip-kernels"
+export PYTORCH_ALLOC_CONF=max_split_size_mb:512
+
+exec "${PYTHON_BIN}" \
+  "${WORKSPACE}/YAQA_wclip/quantize_llama/quantize_finetune_llama.py" \
+  --save_path "${OUTPUT_DIR}" \
+  --hess_path "${HESSIAN_DIR}" \
+  --hessian_validation_path "${HESSIAN_VALIDATION}" \
+  --base_model "${MODEL_PATH}" \
+  --setting "${SETTING}" \
+  --seed 0 \
+  --num_cpu_threads 8 \
+  --ctx_size 2048 \
+  --sigma_reg 1e-2 \
+  --scale_override 1.0 \
+  --codebook realq_wclip \
+  --ft_epochs 0 \
+  --w_bits "${W_BITS}" \
+  --w_groupsize 128 \
+  --td_x 1 \
+  --td_y 128 \
+  --L 16 \
+  --K "${W_BITS}" \
+  --V 1 \
+  --tlut_bits 0 \
+  --decode_mode dense_fake_quant \
+  --calib_tokens_path "${TOKEN_PATH}" \
+  --calib_tokens_sha256 "${TOKEN_SHA}" \
+  --calib_n_seqs 256 \
+  "${AKV_ARGS[@]}"
