+def _sha256_file(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as handle:
+        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _load_calibration_tokens(path, expected_sha256, n_seqs, ctx_size):
+    actual_sha256 = _sha256_file(path)
+    if actual_sha256 != expected_sha256:
+        raise RuntimeError(
+            f'calibration token SHA256 mismatch: {actual_sha256} != '
+            f'{expected_sha256}')
+    payload = torch.load(path, map_location='cpu', weights_only=True)
+    if not isinstance(payload, list) or len(payload) != n_seqs:
+        raise TypeError(
+            f'calibration tokens must be list[{n_seqs}], got '
+            f'{type(payload).__qualname__} length '
+            f'{len(payload) if isinstance(payload, list) else "N/A"}')
+    for index, value in enumerate(payload):
+        if (not isinstance(value, torch.Tensor)
+                or value.dtype != torch.int64
+                or tuple(value.shape) != (ctx_size, )):
+            raise TypeError(
+                f'calibration item {index} must be int64[{ctx_size}], got '
+                f'{type(value).__qualname__}, '
+                f'{getattr(value, "dtype", None)}, '
+                f'{getattr(value, "shape", None)}')
+    tokens = torch.stack(payload, dim=0).contiguous()
+    if tuple(tokens.shape) != (n_seqs, ctx_size):
+        raise RuntimeError(
+            f'calibration tensor shape mismatch: {tuple(tokens.shape)}')
+    return tokens, actual_sha256
 
 
