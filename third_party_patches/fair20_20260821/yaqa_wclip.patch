+@torch.no_grad()
+def reconstruct_dense_weight(
+    artifact: dict[str, Any], *, device: torch.device
+) -> torch.Tensor:
+    """Reconstruct the persisted dense weight from codes/scales/SU/SV."""
+
+    codes = artifact["qweight"]
+    scales = artifact["scale"]
+    columns = int(artifact["weight_ncolumns"])
+    groupsize = int(artifact["groupsize"])
+    if codes.ndim != 2 or codes.shape[1] != columns:
+        raise ValueError("qweight/weight_ncolumns mismatch")
+    group_indices = torch.div(
+        torch.arange(columns, device=device),
+        groupsize,
+        rounding_mode="floor",
+    )
+    expanded_scales = scales.to(device).index_select(1, group_indices)
+    hat_wr = expanded_scales * codes.to(device=device, dtype=torch.float32)
+    su = artifact["SU"].to(device=device, dtype=torch.float32)
+    sv = artifact["SV"].to(device=device, dtype=torch.float32)
+    reconstructed = (
+        utils.matmul_hadU(
+            (utils.matmul_hadU(hat_wr) * su).T
+        )
+        * sv
+    ).T
+    return reconstructed.to(artifact["weight"].dtype).cpu()
+
