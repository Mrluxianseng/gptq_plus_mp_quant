+def first_iteration_hessian_flats(grad_output, input):
+    """Compute the two B-sketch Gram matrices without a 4-operand einsum.
+
+    For one sequence, ``grad_weight = grad_output.T @ input``.  The original
+    contractions are exactly ``grad_weight.T @ grad_weight`` for the input
+    Hessian and ``grad_weight @ grad_weight.T`` for the output Hessian.  Doing
+    the contraction sequence explicitly prevents PyTorch's einsum planner from
+    materializing a tensor whose size grows quadratically with sequence length.
+    """
+    in_hess = None
+    out_hess = None
+    for sample_idx in range(input.shape[0]):
+        grad_weight = grad_output[sample_idx].float().T @ input[
+            sample_idx].float()
+
+        in_gram = grad_weight.T @ grad_weight
+        sample_in_hess = sym_to_flat(in_gram)
+        del in_gram
+
+        out_gram = grad_weight @ grad_weight.T
+        sample_out_hess = sym_to_flat(out_gram)
+        del out_gram, grad_weight
+
+        if in_hess is None:
+            in_hess = sample_in_hess
+            out_hess = sample_out_hess
+        else:
+            in_hess.add_(sample_in_hess)
+            out_hess.add_(sample_out_hess)
+
+    return in_hess, out_hess
+
+
