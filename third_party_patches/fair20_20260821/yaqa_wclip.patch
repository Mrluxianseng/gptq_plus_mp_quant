@@ -0,0 +1,325 @@
+"""REAL-Q-compatible uniform weight quantizer for YAQA.
+
+This module intentionally vendors only REAL-Q's leaf weight quantizer.  It
+does not import or reproduce REAL-Q/GPTQ's column ordering, Hessian update, or
+error-compensation loop.  YAQA still owns all of those decisions through its
+two-sided LDLQ routine.
+
+The default settings match ``WeightQuantizer(..., mse=True)`` in REAL-Q:
+
+* signed symmetric integers with range ``[-(maxq + 1), maxq]``;
+* one scale for each output row and each contiguous natural-column group;
+* ``norm=2.4``, ``grid=50``, and ``maxshrink=0.5``;
+* the historical Cartesian clipping search and strict first-winner tie rule.
+"""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Sequence
+
+import torch
+from torch import nn
+
+
+class WClipQuantizer(nn.Module):
+    """Fixed groupwise uniform lattice with REAL-Q ``w_clip=1`` semantics."""
+
+    quantizer_name = "realq_wclip"
+    version = 1
+    idx_dtype = torch.int8
+    vector_dim = 1
+    supports_qtip_kernel = False
+
+    def __init__(
+        self,
+        *,
+        bits: int,
+        groupsize: int = 128,
+        norm: float = 2.4,
+        grid: int = 50,
+        maxshrink: float = 0.5,
+    ) -> None:
+        super().__init__()
+        if type(bits) is not int or bits not in (2, 3, 4):
+            raise ValueError(f"bits must be one of 2, 3, or 4; got {bits!r}")
+        if type(groupsize) is not int or groupsize <= 0:
+            raise ValueError(
+                f"groupsize must be a positive integer; got {groupsize!r}"
+            )
+        if (
+            isinstance(norm, bool)
+            or not math.isfinite(float(norm))
+            or float(norm) <= 0
+        ):
+            raise ValueError(f"norm must be finite and positive; got {norm!r}")
+        if type(grid) is not int or grid <= 0:
+            raise ValueError(f"grid must be a positive integer; got {grid!r}")
+        if (
+            isinstance(maxshrink, bool)
+            or not math.isfinite(float(maxshrink))
+            or not 0.0 < float(maxshrink) <= 1.0
+            or int(float(maxshrink) * grid) <= 0
+        ):
+            raise ValueError(
+                "maxshrink must be in (0, 1] and select at least one "
+                f"candidate; got {maxshrink!r}"
+            )
+
+        self.bits = bits
+        self.groupsize = groupsize
+        self.norm = float(norm)
+        self.grid = grid
+        self.maxshrink = float(maxshrink)
+        self.search_impl = "cartesian_legacy"
+        self.update_impl = "guarded"
+        self.tie_rule = "strict_lt_first_winner"
+        self.sym = True
+        self.mse = True
+
+        self.register_buffer(
+            "maxq", torch.tensor(2 ** (bits - 1) - 1, dtype=torch.int64)
+        )
+        self.register_buffer("scales", torch.empty(0, dtype=torch.float32))
+        self.weight_ncolumns: int | None = None
+
+    @property
+    def minq(self) -> int:
+        return -(int(self.maxq.item()) + 1)
+
+    @property
+    def qmax(self) -> int:
+        return int(self.maxq.item())
+
+    @torch.no_grad()
+    def fit(self, weight: torch.Tensor) -> "WClipQuantizer":
+        """Fit and freeze one FP32 scale per row/contiguous input group.
+
+        ``weight`` is the matrix in YAQA's quantizer domain: after YAQA's
+        native two-sided randomized Hadamard transform and before LDLQ error
+        feedback.  The complete matrix is observed exactly once.
+        """
+
+        if not isinstance(weight, torch.Tensor) or weight.ndim != 2:
+            shape = getattr(weight, "shape", None)
+            raise ValueError(
+                "weight must be a 2-D [out_rows, in_columns] tensor; "
+                f"got shape {shape!r}"
+            )
+        if weight.dtype != torch.float32:
+            raise TypeError(
+                "REAL-Q-compatible w_clip fitting requires FP32 input; "
+                f"got {weight.dtype}"
+            )
+        if weight.requires_grad:
+            raise ValueError("w_clip fitting requires a no-grad weight tensor")
+        if not bool(torch.isfinite(weight).all()):
+            raise ValueError("w_clip fitting requires finite weights")
+
+        rows, columns = weight.shape
+        full_columns = (columns // self.groupsize) * self.groupsize
+        scale_parts: list[torch.Tensor] = []
+
+        if full_columns:
+            grouped = weight[:, :full_columns].reshape(
+                rows, full_columns // self.groupsize, self.groupsize
+            )
+            scale_parts.append(self._fit_equal_width_groups(grouped))
+
+        # A short final group is observed at its natural width.  It is never
+        # padded, matching REAL-Q's groupwise observer.
+        if full_columns < columns:
+            tail = weight[:, full_columns:].unsqueeze(1)
+            scale_parts.append(self._fit_equal_width_groups(tail))
+
+        self.scales = torch.cat(scale_parts, dim=1)
+        self.weight_ncolumns = columns
+        return self
+
+    def _fit_equal_width_groups(self, grouped: torch.Tensor) -> torch.Tensor:
+        """Run REAL-Q's historical 25x25 Cartesian clipping search."""
+
+        xmax = torch.amax(grouped, dim=-1, keepdim=True)
+        xmin = torch.amin(grouped, dim=-1, keepdim=True)
+        maxq = self.maxq.to(grouped.device)
+        scale = (
+            torch.maximum(torch.abs(xmin), xmax).clamp(min=1e-5) / maxq
+        )
+        best = torch.full(
+            grouped.shape[:2],
+            float("inf"),
+            device=grouped.device,
+            dtype=grouped.dtype,
+        )
+
+        candidate_count = int(self.maxshrink * self.grid)
+        for i in range(candidate_count):
+            for j in range(candidate_count):
+                xmin1 = (1 - i / self.grid) * xmin
+                xmax1 = (1 - j / self.grid) * xmax
+                scale1 = (
+                    torch.maximum(torch.abs(xmin1), xmax1)
+                    .clamp(min=1e-5)
+                    / maxq
+                )
+                q = torch.clamp(
+                    torch.round(grouped / scale1),
+                    -(maxq + 1),
+                    maxq,
+                )
+                q = scale1 * q
+                err = (q - grouped).abs().pow(self.norm).sum(-1)
+                improved = err < best
+                if torch.any(improved):
+                    best[improved] = err[improved]
+                    scale[improved] = scale1[improved]
+
+        return scale.squeeze(-1)
+
+    def _check_fitted(self) -> None:
+        if self.scales.ndim != 2 or self.scales.numel() == 0:
+            raise RuntimeError("fit(weight) must be called before quantization")
+        if self.weight_ncolumns is None:
+            raise RuntimeError("fitted quantizer is missing weight_ncolumns")
+
+    def expanded_scales(self) -> torch.Tensor:
+        """Return scales expanded to ``[out_rows, in_columns]``."""
+
+        self._check_fitted()
+        columns = self.weight_ncolumns
+        natural_columns = torch.arange(columns, device=self.scales.device)
+        group_indices = torch.div(
+            natural_columns, self.groupsize, rounding_mode="floor"
+        )
+        return self.scales.index_select(1, group_indices)
+
+    def quantize_dequantize(
+        self,
+        value: torch.Tensor,
+        *,
+        row_indices: torch.Tensor,
+        column_indices: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Project a submatrix onto its frozen natural row/group lattices."""
+
+        self._check_fitted()
+        if value.ndim != 2:
+            raise ValueError(
+                f"value must be two-dimensional; got shape {tuple(value.shape)}"
+            )
+        row_indices = torch.as_tensor(
+            row_indices, dtype=torch.long, device=self.scales.device
+        ).reshape(-1)
+        column_indices = torch.as_tensor(
+            column_indices, dtype=torch.long, device=self.scales.device
+        ).reshape(-1)
+        if value.shape != (row_indices.numel(), column_indices.numel()):
+            raise ValueError(
+                "value shape must match row_indices x column_indices; "
+                f"got {tuple(value.shape)} versus "
+                f"({row_indices.numel()}, {column_indices.numel()})"
+            )
+        if torch.any(row_indices < 0) or torch.any(
+            row_indices >= self.scales.shape[0]
+        ):
+            raise IndexError("row_indices are outside the fitted weight")
+        if torch.any(column_indices < 0) or torch.any(
+            column_indices >= self.weight_ncolumns
+        ):
+            raise IndexError("column_indices are outside the fitted weight")
+
+        group_indices = torch.div(
+            column_indices, self.groupsize, rounding_mode="floor"
+        )
+        scale = self.scales.index_select(0, row_indices).index_select(
+            1, group_indices
+        )
+        scale = scale.to(device=value.device)
+        maxq = self.maxq.to(value.device)
+        codes = torch.clamp(
+            torch.round(value / scale), -(maxq + 1), maxq
+        )
+        dequantized = (scale * codes).to(value.dtype)
+        return dequantized, codes.to(self.idx_dtype)
+
+    def quantize_tiles(
+        self,
+        target: torch.Tensor,
+        tile_indices: Sequence[tuple[int, int]],
+        *,
+        td_x: int,
+        td_y: int,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Quantize YAQA anti-diagonal tiles without changing their ordering."""
+
+        if target.ndim != 3 or tuple(target.shape[1:]) != (td_x, td_y):
+            raise ValueError(
+                "target must have shape [tiles, td_x, td_y]; got "
+                f"{tuple(target.shape)}"
+            )
+        if len(tile_indices) != target.shape[0]:
+            raise ValueError(
+                "tile_indices must contain one origin per target tile"
+            )
+
+        origins = torch.as_tensor(
+            tile_indices, dtype=torch.long, device=self.scales.device
+        )
+        row_indices = (
+            origins[:, 0, None, None] * td_x
+            + torch.arange(td_x, device=self.scales.device)[None, :, None]
+        )
+        column_indices = (
+            origins[:, 1, None, None] * td_y
+            + torch.arange(td_y, device=self.scales.device)[None, None, :]
+        )
+        if torch.any(row_indices < 0) or torch.any(
+            row_indices >= self.scales.shape[0]
+        ):
+            raise IndexError("tile rows are outside the fitted weight")
+        if torch.any(column_indices < 0) or torch.any(
+            column_indices >= self.weight_ncolumns
+        ):
+            raise IndexError("tile columns are outside the fitted weight")
+
+        group_indices = torch.div(
+            column_indices, self.groupsize, rounding_mode="floor"
+        )
+        # Advanced indices broadcast [tiles, td_x, 1] with
+        # [tiles, 1, td_y], producing one scale for every target element while
+        # quantizing the complete anti-diagonal batch in a single kernel.
+        scale = self.scales[row_indices, group_indices].to(target.device)
+        maxq = self.maxq.to(target.device)
+        codes = torch.clamp(
+            torch.round(target / scale), -(maxq + 1), maxq
+        )
+        return (scale * codes).to(target.dtype), codes.to(self.idx_dtype)
+
+    def dequantize_codes(self, codes: torch.Tensor) -> torch.Tensor:
+        """Dequantize a complete natural-layout integer-code matrix."""
+
+        self._check_fitted()
+        expected = (self.scales.shape[0], self.weight_ncolumns)
+        if tuple(codes.shape) != expected:
+            raise ValueError(
+                f"codes must have shape {expected}; got {tuple(codes.shape)}"
+            )
+        return self.expanded_scales().to(codes.device) * codes.to(
+            self.scales.dtype
+        )
+
+    def clear(self) -> None:
+        """Release fitted per-weight state before observing another matrix."""
+
+        self.scales = torch.empty(
+            0, dtype=torch.float32, device=self.scales.device
+        )
+        self.weight_ncolumns = None
+
+    def extra_repr(self) -> str:
+        return (
+            f"bits={self.bits}, groupsize={self.groupsize}, sym=True, "
+            f"mse=True, norm={self.norm}, grid={self.grid}, "
+            f"maxshrink={self.maxshrink}, search={self.search_impl}, "
+            f"update={self.update_impl}"
+        )
