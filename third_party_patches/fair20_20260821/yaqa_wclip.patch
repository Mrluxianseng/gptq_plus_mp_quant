+def _projection_specs(config):
+    hidden = int(config.hidden_size)
+    head_dim = int(
+        getattr(config, "head_dim", hidden // config.num_attention_heads)
+    )
+    query_hidden = int(config.num_attention_heads) * head_dim
+    kv_hidden = int(config.num_key_value_heads) * head_dim
+    intermediate = int(config.intermediate_size)
+    return {
+        "q": ("self_attn.q_proj", (query_hidden, hidden)),
+        "k": ("self_attn.k_proj", (kv_hidden, hidden)),
+        "v": ("self_attn.v_proj", (kv_hidden, hidden)),
+        "o": ("self_attn.o_proj", (hidden, query_hidden)),
+        "up": ("mlp.up_proj", (intermediate, hidden)),
+        "gate": ("mlp.gate_proj", (intermediate, hidden)),
+        "down": ("mlp.down_proj", (hidden, intermediate)),
+    }
