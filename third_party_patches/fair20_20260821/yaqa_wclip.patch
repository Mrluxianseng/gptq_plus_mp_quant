@@ -0,0 +1,70 @@
+"""Process-local Hessian-mode context for stock Transformers models.
+
+YAQA's copied Llama model threads ``mode`` through every decoder call and into
+``CustomLinear(input, mode)``.  Stock Hugging Face models, including Qwen3,
+correctly call linear projections with only the input tensor.  A context
+variable lets those unchanged forwards use the same Hessian collector without
+copying or altering the model implementation.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from typing import Iterator
+
+
+HessianMode = tuple[int, bool, bool]
+_HESSIAN_MODE: ContextVar[HessianMode | None] = ContextVar(
+    "yaqa_hessian_mode",
+    default=None,
+)
+# PyTorch 2.9 non-reentrant activation-checkpoint recomputation may execute
+# outside the caller's ContextVar context.  Each torchrun rank is a separate
+# process and YAQA runs exactly one forward/backward at a time, so a scoped
+# process-local mirror transports the identical mode deterministically.
+_PROCESS_HESSIAN_MODE: HessianMode | None = None
+
+
+def _validate_mode(mode: HessianMode) -> HessianMode:
+    if (
+        not isinstance(mode, tuple)
+        or len(mode) != 3
+        or type(mode[0]) is not int
+        or type(mode[1]) is not bool
+        or type(mode[2]) is not bool
+    ):
+        raise TypeError(
+            "YAQA Hessian mode must be (iteration:int, reset:bool, "
+            f"divide:bool), got {mode!r}"
+        )
+    return mode
+
+
+def current_hessian_mode() -> HessianMode:
+    mode = _HESSIAN_MODE.get()
+    if mode is None:
+        mode = _PROCESS_HESSIAN_MODE
+    if mode is None:
+        raise RuntimeError(
+            "YAQA CustomLinear was called without an explicit mode and "
+            "outside use_hessian_mode(); refusing an untracked Hessian pass"
+        )
+    return _validate_mode(mode)
+
+
+@contextmanager
+def use_hessian_mode(mode: HessianMode) -> Iterator[None]:
+    global _PROCESS_HESSIAN_MODE
+    validated = _validate_mode(mode)
+    previous_process_mode = _PROCESS_HESSIAN_MODE
+    _PROCESS_HESSIAN_MODE = validated
+    token = _HESSIAN_MODE.set(validated)
+    try:
+        yield
+    finally:
+        _HESSIAN_MODE.reset(token)
+        _PROCESS_HESSIAN_MODE = previous_process_mode
+
+
+__all__ = ["HessianMode", "current_hessian_mode", "use_hessian_mode"]
