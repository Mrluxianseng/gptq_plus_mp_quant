+++ b/tests/test_wclip_provenance.py
@@ -0,0 +1,219 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+import torch
+from transformers import LlamaConfig
+
+from eval.check_eval_inputs import validate_eval_inputs
+from eval.validate_hfized_wclip import reconstruct_dense_weight
+from lib import utils
+from quantize_llama.preflight_wclip import (
+    PROJECTION_NAMES,
+    TOKEN_PATH,
+    TOKEN_SHA256,
+    expected_akv,
+    sha256_file,
+    validate_preflight,
+)
+
+
+def _write_json(path: Path, value) -> None:
+    path.write_text(
+        json.dumps(value, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+
+
+def _fake_hessian_contract(tmp_path: Path, setting: str):
+    model_dir = tmp_path / "model"
+    LlamaConfig(
+        vocab_size=128,
+        hidden_size=128,
+        intermediate_size=256,
+        num_hidden_layers=1,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+    ).save_pretrained(model_dir)
+    model_dir = model_dir.resolve()
+    hessian_dir = (tmp_path / "hessian").resolve()
+    hessian_dir.mkdir()
+    records = []
+    for projection in PROJECTION_NAMES:
+        for side in ("hin", "hout"):
+            path = hessian_dir / f"0_{projection}_{side}.pt"
+            path.write_bytes(f"{projection}:{side}".encode())
+            records.append(
+                {
+                    "path": str(path),
+                    "bytes": path.stat().st_size,
+                    "sha256": sha256_file(path),
+                }
+            )
+    manifest = {
+        "schema_version": 2,
+        "model": str(model_dir),
+        "save_path": str(hessian_dir),
+        "calib_tokens_path": str(TOKEN_PATH),
+        "calib_tokens_sha256": TOKEN_SHA256,
+        "n_seqs": 256,
+        "ctx_size": 2048,
+        "world_size": 4,
+        "batch_size_per_rank": 2,
+        "global_batch_size": 8,
+        "iterations": 32,
+        "start_layer": 0,
+        "end_layer": 1,
+        "hessian_sketch": "B",
+        "power_iters": 1,
+        "fp64_accum_effective": False,
+        "torch_float32_matmul_precision": "highest",
+        "cuda_matmul_fp32_precision": "ieee",
+        "akv": expected_akv(setting, 1),
+    }
+    _write_json(hessian_dir / "manifest.json", manifest)
+    validation = (tmp_path / "validation.json").resolve()
+    _write_json(
+        validation,
+        {
+            "schema_version": 2,
+            "status": "validated",
+            "model": str(model_dir),
+            "hessian_dir": str(hessian_dir),
+            "layer_count": 1,
+            "tensor_count": 14,
+            "manifest": manifest,
+            "tensors": records,
+        },
+    )
+    return model_dir, hessian_dir, validation
+
+
+def test_preflight_binds_aware_hessian_and_fresh_output(tmp_path):
+    model, hessian, validation = _fake_hessian_contract(
+        tmp_path, "W2A4KV4"
+    )
+    output = tmp_path / "fresh-output"
+    result = validate_preflight(
+        model=model,
+        setting="W2A4KV4",
+        weight_bits=2,
+        hessian_dir=hessian,
+        validation_report=validation,
+        output_dir=output,
+    )
+    assert result["setting"] == "W2A4KV4"
+    assert result["hessian_validation_sha256"] == sha256_file(validation)
+    assert result["tensor_count"] == 14
+
+    output.mkdir()
+    with pytest.raises(RuntimeError, match="fresh path"):
+        validate_preflight(
+            model=model,
+            setting="W2A4KV4",
+            weight_bits=2,
+            hessian_dir=hessian,
+            validation_report=validation,
+            output_dir=output,
+        )
+
+
+def test_preflight_rejects_a16_hessian_for_w2_aware(tmp_path):
+    model, hessian, validation = _fake_hessian_contract(
+        tmp_path, "W4A16KV16"
+    )
+    with pytest.raises(RuntimeError, match="does not match"):
+        validate_preflight(
+            model=model,
+            setting="W2A4KV4",
+            weight_bits=2,
+            hessian_dir=hessian,
+            validation_report=validation,
+            output_dir=tmp_path / "output",
+        )
+
+
+def test_reconstruct_dense_weight_detects_integer_artifact_corruption():
+    generator = torch.Generator().manual_seed(31)
+    codes = torch.randint(
+        -8, 8, (4, 8), generator=generator, dtype=torch.int8
+    )
+    scales = torch.rand(4, 2, generator=generator, dtype=torch.float32)
+    su = torch.tensor([1, -1, 1, -1, 1, 1, -1, -1], dtype=torch.float32)
+    sv = torch.tensor([1, -1, -1, 1], dtype=torch.float32)
+    expanded = scales.index_select(1, torch.arange(8) // 4)
+    hat_wr = expanded * codes.float()
+    expected = (
+        utils.matmul_hadU((utils.matmul_hadU(hat_wr) * su).T) * sv
+    ).T.to(torch.bfloat16)
+    artifact = {
+        "qweight": codes,
+        "scale": scales,
+        "weight_ncolumns": 8,
+        "groupsize": 4,
+        "SU": su.to(torch.bfloat16),
+        "SV": sv.to(torch.bfloat16),
+        "weight": expected,
+    }
+    actual = reconstruct_dense_weight(artifact, device=torch.device("cpu"))
+    assert torch.equal(actual, expected)
+
+    corrupted = dict(artifact)
+    corrupted["qweight"] = codes.clone()
+    corrupted["qweight"][0, 0] += 1
+    assert not torch.equal(
+        reconstruct_dense_weight(corrupted, device=torch.device("cpu")),
+        expected,
+    )
+
+
+def test_eval_input_freshness_rejects_same_size_mutation(tmp_path):
+    model = (tmp_path / "model").resolve()
+    model.mkdir()
+    hf_dir = (tmp_path / "hf").resolve()
+    hf_dir.mkdir()
+    first = hf_dir / "config.json"
+    second = hf_dir / "model.safetensors"
+    first.write_bytes(b"config")
+    second.write_bytes(b"weight")
+    records = [
+        {
+            "path": str(path),
+            "bytes": path.stat().st_size,
+            "sha256": sha256_file(path),
+        }
+        for path in (first, second)
+    ]
+    validation = (tmp_path / "hf-validation.json").resolve()
+    _write_json(
+        validation,
+        {
+            "schema_version": 2,
+            "status": "validated",
+            "model": str(model),
+            "setting": "W4A16KV16",
+            "hf_dir": str(hf_dir),
+            "runtime_weight_representation": "dense_fake_quant",
+            "packed": False,
+            "lowbit_kernel": False,
+            "hf_files": records,
+        },
+    )
+    result = validate_eval_inputs(
+        model=str(model),
+        setting="W4A16KV16",
+        hf_dir=str(hf_dir),
+        validation_report=str(validation),
+    )
+    assert result["hf_file_count"] == 2
+
+    second.write_bytes(b"Weight")
+    with pytest.raises(RuntimeError, match="changed"):
+        validate_eval_inputs(
+            model=str(model),
+            setting="W4A16KV16",
+            hf_dir=str(hf_dir),
+            validation_report=str(validation),
+        )
