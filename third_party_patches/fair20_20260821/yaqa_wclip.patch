+        raise RuntimeError("dense w_clip model contains a QTIP QuantizedLinear")
+    runtime = _validate_runtime(model, setting, layer_count)
+    fingerprints = {}
+    for name, input_ids in (
+        ("one_token", one_token),
+        ("thirty_two_tokens", many_tokens),
+    ):
+        logits = model(
+            input_ids.cuda(),
+            use_cache=False,
+            output_hidden_states=False,
+            output_attentions=False,
