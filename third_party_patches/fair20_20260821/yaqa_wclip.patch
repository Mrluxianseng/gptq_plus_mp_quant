+#!/usr/bin/env python3
+"""Verify that a validated YAQA_wclip HF tree is unchanged before eval."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from quantize_llama.preflight_wclip import SETTING_BITS, sha256_file
+
+
+def validate_eval_inputs(
+    *,
+    model: str,
+    setting: str,
+    hf_dir: str,
+    validation_report: str,
+) -> dict[str, Any]:
+    model_path = Path(model).resolve()
+    hf_path = Path(hf_dir).resolve()
+    validation_path = Path(validation_report).resolve()
+    report = json.loads(validation_path.read_text(encoding="utf-8"))
+    if (
+        report.get("schema_version") != 2
+        or report.get("status") != "validated"
+        or report.get("model") != str(model_path)
+        or report.get("setting") != setting
+        or Path(report.get("hf_dir", "")).resolve() != hf_path
+        or report.get("runtime_weight_representation")
+        != "dense_fake_quant"
+        or report.get("packed") is not False
+        or report.get("lowbit_kernel") is not False
+    ):
+        raise RuntimeError("YAQA_wclip validation report header mismatch")
+
+    records = report.get("hf_files")
+    if not isinstance(records, list) or not records:
+        raise RuntimeError("validation report has no HF file records")
+    records_by_path = {
+        Path(record.get("path", "")).resolve(): record
+        for record in records
+        if isinstance(record, dict)
+    }
+    if len(records_by_path) != len(records):
+        raise RuntimeError("validation report contains duplicate HF paths")
+    live_paths = {path.resolve() for path in hf_path.rglob("*") if path.is_file()}
+    if live_paths != set(records_by_path):
+        raise RuntimeError(
+            "HF file set changed after validation: "
+            f"missing={sorted(str(p) for p in set(records_by_path) - live_paths)}, "
+            f"extra={sorted(str(p) for p in live_paths - set(records_by_path))}"
+        )
+    for path, record in records_by_path.items():
+        if (
+            record.get("bytes") != path.stat().st_size
+            or record.get("sha256") != sha256_file(path)
+        ):
+            raise RuntimeError(f"HF file changed after validation: {path}")
+
+    return {
+        "status": "ready",
+        "model": str(model_path),
+        "setting": setting,
+        "hf_dir": str(hf_path),
+        "validation_report": str(validation_path),
+        "validation_report_sha256": sha256_file(validation_path),
+        "hf_file_count": len(records_by_path),
+        "runtime_weight_representation": "dense_fake_quant",
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
