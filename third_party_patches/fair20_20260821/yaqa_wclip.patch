+            ):
+                raise RuntimeError(f"{path}: invalid compact G128 scales")
+            if (
+                tuple(dense_weight.shape) != shape
+                or not torch.isfinite(dense_weight).all()
+                or tuple(su.shape) != (in_features,)
+                or tuple(sv.shape) != (out_features,)
+                or su.dtype != dense_weight.dtype
+                or sv.dtype != dense_weight.dtype
+                or not torch.equal(su.abs(), torch.ones_like(su))
+                or not torch.equal(sv.abs(), torch.ones_like(sv))
+            ):
+                raise RuntimeError(f"{path}: invalid dense weight or RHT signs")
+            deployed = _resolve_attr(layer, dotted_name)
+            if (
+                type(deployed) is not nn.Linear
+                or dense_weight.dtype != deployed.weight.dtype
+                or not torch.equal(
+                    deployed.weight.cpu(),
+                    dense_weight.to(deployed.weight.dtype),
+                )
+            ):
+                raise RuntimeError(f"{path}: hfized dense weight mismatch")
+            reconstructed = reconstruct_dense_weight(
+                value, device=reconstruction_device
+            )
+            if not torch.equal(reconstructed, dense_weight):
+                max_abs = float(
+                    (reconstructed.float() - dense_weight.float())
+                    .abs()
+                    .max()
+                )
+                raise RuntimeError(
+                    f"{path}: codes/scales/SU/SV do not reconstruct dense "
+                    f"weight (max_abs={max_abs})"
+                )
+            for metric_name in (
+                "proxy_err",
+                "proxy_err_ratio",
+                "one_sided_proxy_err",
+                "one_sided_proxy_err_ratio",
+            ):
+                if not math.isfinite(float(value[metric_name])):
+                    raise RuntimeError(f"{path}: non-finite {metric_name}")
+            projection_records.append(
+                {
+                    "path": str(path),
+                    "bytes": path.stat().st_size,
+                    "sha256": sha256_file(path),
+                    "qweight_shape": list(codes.shape),
+                    "scale_shape": list(scales.shape),
+                    "code_min": int(codes.min()),
+                    "code_max": int(codes.max()),
+                    "dense_reconstruction_exact": True,
+                }
+            )
+            del reconstructed, value
+            torch.cuda.empty_cache()
+    if len(projection_records) != 7 * layer_count:
+        raise RuntimeError("validated projection count mismatch")
+
+    base_tokenizer = AutoTokenizer.from_pretrained(model_path)
+    hf_tokenizer = AutoTokenizer.from_pretrained(hf_dir)
+    probe = "YAQA_wclip tokenizer parity: 256 sequences, 2048 tokens each."
+    if (
+        type(hf_tokenizer) is not type(base_tokenizer)
+        or hf_tokenizer.get_vocab() != base_tokenizer.get_vocab()
+        or hf_tokenizer.special_tokens_map
+        != base_tokenizer.special_tokens_map
+        or hf_tokenizer.chat_template != base_tokenizer.chat_template
+        or hf_tokenizer(probe)["input_ids"]
+        != base_tokenizer(probe)["input_ids"]
+    ):
+        raise RuntimeError("hfized tokenizer differs from base tokenizer")
+    if (
+        GenerationConfig.from_pretrained(hf_dir).to_diff_dict()
+        != GenerationConfig.from_pretrained(model_path).to_diff_dict()
+    ):
+        raise RuntimeError(
+            "hfized generation config differs from base model"
+        )
+
+    del model
+    gc.collect()
+    torch.cuda.empty_cache()
+    calibration_path = Path(provenance["calib_tokens_path"])
+    calibration = torch.load(
+        calibration_path, map_location="cpu", weights_only=True
+    )
+    one_token = calibration[0][:1].reshape(1, 1)
+    many_tokens = calibration[0][:32].reshape(1, 32)
+    first_fingerprints, first_runtime = _load_and_smoke(
+        hf_dir,
+        args.setting,
+        layer_count,
+        one_token,
+        many_tokens,
+    )
+    second_fingerprints, second_runtime = _load_and_smoke(
+        hf_dir,
+        args.setting,
+        layer_count,
+        one_token,
+        many_tokens,
+    )
+    if (
+        first_fingerprints != second_fingerprints
+        or first_runtime != second_runtime
+        or first_runtime != runtime
+    ):
+        raise RuntimeError("hfized reload smoke is not deterministic")
+
+    hf_files = sorted(path for path in hf_dir.rglob("*") if path.is_file())
+    required_names = {
+        "config.json",
+        "tokenizer.json",
+        "tokenizer_config.json",
+    }
+    names = {path.name for path in hf_files}
+    if not required_names.issubset(names):
+        raise RuntimeError(
+            "hfized directory misses tokenizer/config files: "
+            f"{sorted(required_names - names)}"
+        )
+    if not any(
+        name.endswith(".safetensors")
+        or name == "model.safetensors.index.json"
+        for name in names
+    ):
+        raise RuntimeError("hfized directory contains no safetensors weights")
+    hf_records = [
+        {
+            "path": str(path),
+            "bytes": path.stat().st_size,
+            "sha256": sha256_file(path),
+        }
+        for path in hf_files
+    ]
+
+    report = {
+        "schema_version": 2,
+        "status": "validated",
+        "model": str(model_path),
+        "setting": args.setting,
+        "raw_dir": str(raw_dir),
+        "hf_dir": str(hf_dir),
+        "weight_quantizer": "realq_wclip",
+        "weight_bits": expected_bits,
+        "weight_groupsize": 128,
+        "runtime_weight_representation": "dense_fake_quant",
+        "packed": False,
+        "lowbit_kernel": False,
+        "layer_count": layer_count,
+        "projection_count": len(projection_records),
+        "runtime_akv": runtime,
+        "calib_tokens_path": provenance["calib_tokens_path"],
+        "calib_tokens_sha256": provenance["calib_tokens_sha256"],
+        "hessian_validation": provenance["hessian_validation_path"],
+        "hessian_validation_sha256": provenance[
+            "hessian_validation_sha256"
+        ],
+        "hessian_manifest": provenance["hessian_manifest_path"],
+        "hessian_manifest_sha256": provenance[
+            "hessian_manifest_sha256"
+        ],
+        "raw_config": raw_config_record,
+        "raw_layernorm_files": layernorm_records,
+        "raw_projection_files": projection_records,
+        "integer_reconstruction_verified": True,
+        "hf_files": hf_records,
+        "smoke_logits_sha256": first_fingerprints,
+        "reload_deterministic": True,
+    }
+    _write_json_atomic(output, report)
+    print(
+        json.dumps(
+            {
+                key: report[key]
+                for key in (
+                    "status",
+                    "model",
+                    "setting",
+                    "weight_bits",
+                    "weight_groupsize",
+                    "runtime_weight_representation",
+                    "projection_count",
+                    "runtime_akv",
+                    "integer_reconstruction_verified",
+                    "smoke_logits_sha256",
+                    "reload_deterministic",
+                )
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
