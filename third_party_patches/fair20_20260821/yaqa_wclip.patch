+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 2 ]]; then
+  echo "usage: $0 <raw-quantized-dir> <fresh-hf-output-dir>"
+  exit 2
+fi
+
+RAW_DIR=$1
+HF_DIR=$2
+WORKSPACE=${REALQ_WORKSPACE:-/minimax-avatar-new/zhangqian/realq/gptq_plus}
+PYTHON_BIN=${PYTHON_BIN:-${WORKSPACE}/.venv/bin/python}
+
+if [[ ! -f "${RAW_DIR}/config.pt" ]]; then
+  echo "raw directory has no config.pt: ${RAW_DIR}"
+  exit 2
+fi
+if [[ -e "${HF_DIR}" ]]; then
+  echo "hfized output must be a fresh path: ${HF_DIR}"
+  exit 2
+fi
+
+cd "${WORKSPACE}"
+export CUDA_VISIBLE_DEVICES=
+export PYTHONPATH="${WORKSPACE}/YAQA_wclip:${WORKSPACE}:${WORKSPACE}/YAQA_wclip/qtip-kernels"
+
+"${PYTHON_BIN}" \
+  "${WORKSPACE}/YAQA_wclip/quantize_llama/hfize_llama.py" \
+  --quantized_path "${RAW_DIR}" \
+  --hf_output_path "${HF_DIR}"
+
+find "${HF_DIR}" -maxdepth 1 -type f -exec chmod 0644 {} +
diff --git a/scripts/run_postprocess_lane.sh b/scripts/run_postprocess_lane.sh
new file mode 100755
index 0000000..e12188d
--- /dev/null
+++ b/scripts/run_postprocess_lane.sh
@@ -0,0 +1,587 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 3 ]]; then
+  echo "usage: $0 <1b|3b> <cuda-visible-list> <campaign-output-root>"
+  exit 2
+fi
+
+MODEL_SIZE=$1
+VISIBLE_GPUS=$2
+OUTPUT_ROOT=$3
+
+WORKSPACE=${REALQ_WORKSPACE:-/minimax-avatar-new/zhangqian/realq/gptq_plus}
+PYTHON_BIN=${PYTHON_BIN:-${WORKSPACE}/.venv/bin/python}
+RUN_HFIZE=${WORKSPACE}/YAQA_wclip/scripts/run_hfize.sh
+RUN_VALIDATE=${WORKSPACE}/YAQA_wclip/scripts/run_validate_hfized.sh
+RUN_EVALUATE=${WORKSPACE}/YAQA_wclip/scripts/run_evaluate.sh
+
+RAW_ROOT=${OUTPUT_ROOT}/raw
+HF_ROOT=${OUTPUT_ROOT}/hf
+VALIDATION_ROOT=${OUTPUT_ROOT}/validation
+RESULT_ROOT=${OUTPUT_ROOT}/results
+LOG_ROOT=${OUTPUT_ROOT}/logs
+STATE_ROOT=${OUTPUT_ROOT}/state
+LOCK_PATH=${STATE_ROOT}/postprocess_${MODEL_SIZE}.lock
+ACTIVE_PIDS=()
+
+IFS=',' read -r -a GPU_ARRAY <<< "${VISIBLE_GPUS}"
+if [[ ${#GPU_ARRAY[@]} -ne 4 ]]; then
+  echo "postprocess lane requires exactly four GPUs, got: ${VISIBLE_GPUS}" >&2
+  exit 2
+fi
+if [[ $(printf '%s\n' "${GPU_ARRAY[@]}" | sort -u | wc -l) -ne 4 ]]; then
+  echo "postprocess lane GPU list contains duplicates: ${VISIBLE_GPUS}" >&2
+  exit 2
+fi
+for gpu in "${GPU_ARRAY[@]}"; do
+  if [[ ! "${gpu}" =~ ^[0-9]+$ || ${gpu} -gt 7 ]]; then
+    echo "invalid physical GPU index for this 8-GPU job: ${gpu}" >&2
+    exit 2
+  fi
+done
+
+case "${MODEL_SIZE}" in
+  1b)
+    MODEL_PATH=${WORKSPACE}/modelzoo/Llama/Llama-3.2-1B
+    RUN_IDS=(
+      llama32_1b_w4a16kv16_formal1
+      llama32_1b_w3a16kv16_formal1
+      llama32_1b_w2a4kv4_aware_formal1
+    )
+    ;;
+  3b)
+    MODEL_PATH=${WORKSPACE}/modelzoo/Llama/Llama-3.2-3B
+    RUN_IDS=(
+      llama32_3b_w4a16kv16_formal1
+      llama32_3b_w3a16kv16_formal1
+      llama32_3b_w2a4kv4_aware_formal1
+    )
+    ;;
+  *) echo "unsupported model size: ${MODEL_SIZE}"; exit 2 ;;
+esac
+
+SETTINGS=(W4A16KV16 W3A16KV16 W2A4KV4)
+
+mkdir -p \
+  "${HF_ROOT}" \
+  "${VALIDATION_ROOT}" \
+  "${RESULT_ROOT}" \
+  "${LOG_ROOT}" \
+  "${STATE_ROOT}"
+
+exec {LOCK_FD}> "${LOCK_PATH}"
+if ! flock -n "${LOCK_FD}"; then
+  echo "another postprocess lane already holds ${LOCK_PATH}" >&2
+  exit 3
+fi
+
+atomic_state() {
+  local state_path=$1
+  shift
+  {
+    printf 'model_size=%s\n' "${MODEL_SIZE}"
+    printf 'visible_gpus=%s\n' "${VISIBLE_GPUS}"
+    printf '%s\n' "$@"
+  } > "${state_path}.tmp"
+  mv "${state_path}.tmp" "${state_path}"
+}
+
+state_status() {
+  local state_path=$1
+  if [[ -f "${state_path}" ]]; then
+    awk -F= '$1 == "status" {print $2; exit}' "${state_path}"
+  fi
+  return 0
+}
+
+valid_hf_dir() {
+  local hf_dir=$1
+  local weights_ok=false
+  if [[ -s "${hf_dir}/model.safetensors" ]]; then
+    weights_ok=true
+  elif [[ -s "${hf_dir}/model.safetensors.index.json" ]] &&
+       find "${hf_dir}" \
+         -maxdepth 1 \
+         -type f \
+         -name 'model-*.safetensors' \
+         -size +0c \
+         -print \
+         -quit |
+       grep -q .; then
+    weights_ok=true
+  fi
+  [[ "${weights_ok}" == true &&
+     -s "${hf_dir}/config.json" &&
+     -s "${hf_dir}/generation_config.json" &&
+     -s "${hf_dir}/tokenizer.json" &&
+     -s "${hf_dir}/tokenizer_config.json" ]]
+}
+
+valid_validation_report() {
+  local report=$1
+  local setting=$2
+  local hf_dir=$3
+  if ! jq -e \
+    --arg setting "${setting}" \
+    --arg hf_dir "${hf_dir}" \
+    '
+      .status == "validated" and
+      .schema_version == 2 and
+      .setting == $setting and
+      .hf_dir == $hf_dir and
+      .runtime_weight_representation == "dense_fake_quant" and
+      .packed == false and
+      .lowbit_kernel == false and
+      .integer_reconstruction_verified == true and
+      .reload_deterministic == true and
+      (.projection_count | type == "number" and . > 0) and
+      (
+        .raw_config.sha256 |
+        type == "string" and length == 64
+      ) and
+      (
+        .smoke_logits_sha256 |
+        type == "object" and
+        length == 2 and
+        all(.[]; type == "string" and length == 64)
+      ) and
+      (
+        .hf_files |
+        type == "array" and
+        length > 0 and
+        all(.[];
+          (.path | type == "string" and length > 0) and
+          (.bytes | type == "number" and . > 0) and
+          (.sha256 | type == "string" and length == 64)
+        )
+      )
+    ' \
+    "${report}" > /dev/null; then
+    return 1
+  fi
+  CUDA_VISIBLE_DEVICES= \
+  PYTHONPATH="${WORKSPACE}/YAQA_wclip:${WORKSPACE}:${WORKSPACE}/YAQA_wclip/qtip-kernels" \
+    "${PYTHON_BIN}" \
+    "${WORKSPACE}/YAQA_wclip/eval/check_eval_inputs.py" \
+    --model "${MODEL_PATH}" \
+    --setting "${setting}" \
+    --hf-dir "${hf_dir}" \
+    --validation-report "${report}" \
+    > /dev/null
+}
+
+valid_evaluation_result() {
+  local result=$1
+  local setting=$2
+  local hf_dir=$3
+  local validation=$4
+  local validation_sha256
+  validation_sha256=$(sha256sum "${validation}" | awk '{print $1}')
+  jq -e \
+    --arg setting "${setting}" \
+    --arg hf_dir "${hf_dir}" \
+    --arg validation "${validation}" \
+    --arg validation_sha256 "${validation_sha256}" \
+    '
+      .status == "evaluated" and
+      .schema_version == 1 and
+      .setting == $setting and
+      .hf_dir == $hf_dir and
+      .hf_validation == $validation and
+      .hf_validation_sha256 == $validation_sha256 and
+      (
+        .hf_validation_sha256 |
+        type == "string" and length == 64
+      ) and
+      (
+        .metrics.wikitext2.ppl |
+        type == "number" and . > 0 and . < 1000000000
+      ) and
+      (
+        .metrics.wikitext2.kl_raw |
+        type == "number" and . >= 0 and . < 1000000000
+      ) and
+      (
+        .metrics.wikitext2.kl_x100 |
+        type == "number" and . >= 0 and . < 1000000000
+      ) and
+      (
+        (.metrics.lm_eval.tasks | keys | sort) ==
+        ([
+          "arc_challenge",
+          "arc_easy",
+          "boolq",
+          "ceval-valid",
+          "hellaswag",
+          "lambada_openai",
+          "openbookqa",
+          "piqa",
+          "social_iqa",
+          "winogrande"
+        ] | sort)
+      )
+    ' \
+    "${result}" > /dev/null
+}
+
+wait_for_quantized() {
+  local run_id=$1
+  local quant_state=${STATE_ROOT}/${run_id}.quantize.state
+  local lane_state=${STATE_ROOT}/lane_${MODEL_SIZE}.state
+  local status
+  local lane_status
+
+  while true; do
+    status=$(state_status "${quant_state}")
+    case "${status}" in
+      completed)
+        if [[ -s "${RAW_ROOT}/${run_id}/config.pt" ]]; then
+          return 0
+        fi
+        echo "completed quant state has no raw config.pt: ${run_id}" >&2
+        return 1
+        ;;
+      failed)
+        echo "quantization failed for ${run_id}; refusing to hfize" >&2
+        return 1
+        ;;
+    esac
+
+    lane_status=$(state_status "${lane_state}")
+    if [[ "${lane_status}" == failed ]]; then
+      echo "quantization lane ${MODEL_SIZE} failed before ${run_id} completed" >&2
+      return 1
+    fi
+    if [[ "${lane_status}" == completed ]]; then
+      echo "inconsistent state: lane ${MODEL_SIZE} completed without ${run_id}" >&2
+      return 1
+    fi
+    sleep 20
+  done
+}
+
+run_hfize_one() {
+  local run_id=$1
+  local raw_dir=${RAW_ROOT}/${run_id}
+  local hf_dir=${HF_ROOT}/${run_id}
+  local log_path=${LOG_ROOT}/${run_id}.hfize.log
+  local state_path=${STATE_ROOT}/${run_id}.hfize.state
+  local existing_status
+  local started_at
+  local finished_at
+  local start_epoch
+  local end_epoch
+  local rc
+
+  existing_status=$(state_status "${state_path}")
+  if [[ "${existing_status}" == completed ]]; then
+    if valid_hf_dir "${hf_dir}"; then
+      return 0
+    fi
+    echo "completed hfize state has an invalid artifact: ${hf_dir}" >&2
+    return 2
+  fi
+  if [[ -e "${hf_dir}" || -L "${hf_dir}" ]]; then
+    echo "refusing ambiguous pre-existing hfized path: ${hf_dir}" >&2
+    return 2
+  fi
+
+  started_at=$(date --iso-8601=seconds)
+  start_epoch=$(date +%s)
+  atomic_state "${state_path}" \
+    "status=running" \
+    "started_at=${started_at}" \
+    "raw_dir=${raw_dir}" \
+    "hf_dir=${hf_dir}" \
+    "log_path=${log_path}"
+
+  set +e
+  "${RUN_HFIZE}" "${raw_dir}" "${hf_dir}" > "${log_path}" 2>&1
+  rc=$?
+  set -e
+
+  finished_at=$(date --iso-8601=seconds)
+  end_epoch=$(date +%s)
+  if [[ ${rc} -eq 0 ]]; then
+    atomic_state "${state_path}" \
+      "status=completed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=$((end_epoch - start_epoch))" \
+      "exit_code=0" \
+      "raw_dir=${raw_dir}" \
+      "hf_dir=${hf_dir}" \
+      "log_path=${log_path}"
+  else
+    atomic_state "${state_path}" \
+      "status=failed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=$((end_epoch - start_epoch))" \
+      "exit_code=${rc}" \
+      "raw_dir=${raw_dir}" \
+      "hf_dir=${hf_dir}" \
+      "log_path=${log_path}"
+    return "${rc}"
+  fi
+}
+
+run_validate_one() {
+  local run_id=$1
+  local setting=$2
+  local gpu=$3
+  local raw_dir=${RAW_ROOT}/${run_id}
+  local hf_dir=${HF_ROOT}/${run_id}
+  local report=${VALIDATION_ROOT}/${run_id}.json
+  local log_path=${LOG_ROOT}/${run_id}.validate.log
+  local state_path=${STATE_ROOT}/${run_id}.validate.state
+  local existing_status
+  local started_at
+  local finished_at
+  local start_epoch
+  local end_epoch
+  local rc
+
+  existing_status=$(state_status "${state_path}")
+  if [[ "${existing_status}" == completed ]]; then
+    if valid_validation_report "${report}" "${setting}" "${hf_dir}"; then
+      return 0
+    fi
+    echo "completed validation state has an invalid report: ${report}" >&2
+    return 2
+  fi
+  if [[ -e "${report}" || -L "${report}" ]]; then
+    echo "refusing ambiguous pre-existing validation report: ${report}" >&2
+    return 2
+  fi
+
+  started_at=$(date --iso-8601=seconds)
+  start_epoch=$(date +%s)
+  atomic_state "${state_path}" \
+    "setting=${setting}" \
+    "gpu=${gpu}" \
+    "status=running" \
+    "started_at=${started_at}" \
+    "report=${report}" \
+    "log_path=${log_path}"
+
+  set +e
+  "${RUN_VALIDATE}" \
+    "${MODEL_SIZE}" \
+    "${setting}" \
+    "${raw_dir}" \
+    "${hf_dir}" \
+    "${report}" \
+    "${gpu}" \
+    > "${log_path}" 2>&1
+  rc=$?
+  set -e
+
+  finished_at=$(date --iso-8601=seconds)
+  end_epoch=$(date +%s)
+  if [[ ${rc} -eq 0 ]]; then
+    atomic_state "${state_path}" \
+      "setting=${setting}" \
+      "gpu=${gpu}" \
+      "status=completed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=$((end_epoch - start_epoch))" \
+      "exit_code=0" \
+      "report=${report}" \
+      "log_path=${log_path}"
+  else
+    atomic_state "${state_path}" \
+      "setting=${setting}" \
+      "gpu=${gpu}" \
+      "status=failed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=$((end_epoch - start_epoch))" \
+      "exit_code=${rc}" \
+      "report=${report}" \
+      "log_path=${log_path}"
+    return "${rc}"
+  fi
+}
+
+run_evaluate_one() {
+  local run_id=$1
+  local setting=$2
+  local gpu=$3
+  local hf_dir=${HF_ROOT}/${run_id}
+  local validation=${VALIDATION_ROOT}/${run_id}.json
+  local result=${RESULT_ROOT}/${run_id}.json
+  local log_path=${LOG_ROOT}/${run_id}.evaluate.log
+  local state_path=${STATE_ROOT}/${run_id}.evaluate.state
+  local existing_status
+  local started_at
+  local finished_at
+  local start_epoch
+  local end_epoch
+  local rc
+
+  existing_status=$(state_status "${state_path}")
+  if [[ "${existing_status}" == completed ]]; then
+    if valid_evaluation_result \
+      "${result}" \
+      "${setting}" \
+      "${hf_dir}" \
+      "${validation}"; then
+      return 0
+    fi
+    echo "completed evaluation state has an invalid result: ${result}" >&2
+    return 2
+  fi
+  if [[ -e "${result}" || -L "${result}" ]]; then
+    echo "refusing ambiguous pre-existing result: ${result}" >&2
+    return 2
+  fi
+
+  started_at=$(date --iso-8601=seconds)
+  start_epoch=$(date +%s)
+  atomic_state "${state_path}" \
+    "setting=${setting}" \
+    "gpu=${gpu}" \
+    "status=running" \
+    "started_at=${started_at}" \
+    "result=${result}" \
+    "log_path=${log_path}"
+
+  set +e
+  "${RUN_EVALUATE}" \
+    "${MODEL_SIZE}" \
+    "${setting}" \
+    "${hf_dir}" \
+    "${validation}" \
+    "${result}" \
+    "${gpu}" \
+    > "${log_path}" 2>&1
+  rc=$?
+  set -e
+
+  finished_at=$(date --iso-8601=seconds)
+  end_epoch=$(date +%s)
+  if [[ ${rc} -eq 0 ]]; then
+    atomic_state "${state_path}" \
+      "setting=${setting}" \
+      "gpu=${gpu}" \
+      "status=completed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=$((end_epoch - start_epoch))" \
+      "exit_code=0" \
+      "result=${result}" \
+      "log_path=${log_path}"
+  else
+    atomic_state "${state_path}" \
+      "setting=${setting}" \
+      "gpu=${gpu}" \
+      "status=failed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=$((end_epoch - start_epoch))" \
+      "exit_code=${rc}" \
+      "result=${result}" \
+      "log_path=${log_path}"
+    return "${rc}"
+  fi
+}
+
+run_parallel_stage() {
+  local stage=$1
+  local rc=0
+  local index
+
+  ACTIVE_PIDS=()
+  for index in 0 1 2; do
+    case "${stage}" in
+      validate)
+        run_validate_one \
+          "${RUN_IDS[${index}]}" \
+          "${SETTINGS[${index}]}" \
+          "${GPU_ARRAY[${index}]}" &
+        ;;
+      evaluate)
+        run_evaluate_one \
+          "${RUN_IDS[${index}]}" \
+          "${SETTINGS[${index}]}" \
+          "${GPU_ARRAY[${index}]}" &
+        ;;
+      *) echo "unsupported parallel stage: ${stage}" >&2; return 2 ;;
+    esac
+    ACTIVE_PIDS+=("$!")
+  done
+
+  for index in 0 1 2; do
+    if ! wait "${ACTIVE_PIDS[${index}]}"; then
+      rc=1
+    fi
+  done
+  ACTIVE_PIDS=()
+  return "${rc}"
+}
+
+POSTPROCESS_STARTED_AT=$(date --iso-8601=seconds)
+
+finish_postprocess_state() {
+  local rc=$?
+  if [[ ${rc} -ne 0 ]]; then
+    atomic_state "${STATE_ROOT}/postprocess_${MODEL_SIZE}.state" \
+      "status=failed" \
+      "started_at=${POSTPROCESS_STARTED_AT}" \
+      "finished_at=$(date --iso-8601=seconds)" \
+      "exit_code=${rc}"
+  fi
+}
+
+terminate_active_children() {
+  local signal=$1
+  local pid
+  trap - INT TERM
+  for pid in "${ACTIVE_PIDS[@]}"; do
+    pkill "-${signal}" -P "${pid}" 2> /dev/null || true
+    kill "-${signal}" "${pid}" 2> /dev/null || true
+  done
+  for pid in "${ACTIVE_PIDS[@]}"; do
+    wait "${pid}" 2> /dev/null || true
+  done
+  exit 130
+}
+
+trap finish_postprocess_state EXIT
+trap 'terminate_active_children INT' INT
+trap 'terminate_active_children TERM' TERM
+
+atomic_state "${STATE_ROOT}/postprocess_${MODEL_SIZE}.state" \
+  "status=waiting_for_quantized" \
+  "started_at=${POSTPROCESS_STARTED_AT}"
+
+for index in 0 1 2; do
+  wait_for_quantized "${RUN_IDS[${index}]}"
+  atomic_state "${STATE_ROOT}/postprocess_${MODEL_SIZE}.state" \
+    "status=hfizing" \
+    "started_at=${POSTPROCESS_STARTED_AT}" \
+    "current_run_id=${RUN_IDS[${index}]}"
+  run_hfize_one "${RUN_IDS[${index}]}"
+done
+
+atomic_state "${STATE_ROOT}/postprocess_${MODEL_SIZE}.state" \
+  "status=validating" \
+  "started_at=${POSTPROCESS_STARTED_AT}"
+run_parallel_stage validate
+
+atomic_state "${STATE_ROOT}/postprocess_${MODEL_SIZE}.state" \
+  "status=evaluating" \
+  "started_at=${POSTPROCESS_STARTED_AT}"
+run_parallel_stage evaluate
+
+atomic_state "${STATE_ROOT}/postprocess_${MODEL_SIZE}.state" \
+  "status=completed" \
+  "started_at=${POSTPROCESS_STARTED_AT}" \
+  "finished_at=$(date --iso-8601=seconds)" \
+  "exit_code=0"
+
+trap - EXIT
+trap - INT TERM
diff --git a/scripts/run_quantize.sh b/scripts/run_quantize.sh
