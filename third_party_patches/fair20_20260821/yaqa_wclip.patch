+from quantize_llama.hfize_llama import load_quantized_projection
+
+
+def test_runtime_projection_is_dense_linear_for_wclip():
+    config = SimpleNamespace(
+        quip_params={"quantizer": "realq_wclip"},
+        torch_dtype=torch.bfloat16,
+    )
+    module = _weight_projection(
+        config,
+        in_features=8,
+        out_features=4,
+        td_x=1,
+        td_y=128,
+        L=16,
+        K=4,
+        V=1,
+        tlut_bits=0,
+        decode_mode="unused",
+        bias=False,
+    )
+    assert type(module) is nn.Linear
+    assert module.weight.dtype == torch.bfloat16
+    assert module.weight.shape == (4, 8)
+
+
+def test_hfize_loads_dense_fake_quant_weight(tmp_path):
+    expected = torch.arange(15, dtype=torch.float32).reshape(3, 5)
+    artifact = tmp_path / "projection.pt"
+    torch.save(
+        {
+            "quantizer": "realq_wclip",
+            "bits": 3,
+            "groupsize": 128,
+            "weight": expected,
+        },
+        artifact,
+    )
+    module = nn.Linear(5, 3, bias=False, dtype=torch.bfloat16)
+    load_quantized_projection(
+        module,
+        artifact,
+        is_wclip=True,
+        quip_params={"w_bits": 3, "w_groupsize": 128},
+    )
+    assert torch.equal(module.weight, expected.to(torch.bfloat16))
+
+
+def test_hfize_rejects_mismatched_quantizer_metadata(tmp_path):
+    artifact = tmp_path / "projection.pt"
+    torch.save(
+        {
+            "quantizer": "realq_wclip",
+            "bits": 4,
+            "groupsize": 32,
+            "weight": torch.zeros(3, 5),
+        },
+        artifact,
+    )
+    module = nn.Linear(5, 3, bias=False)
+    with pytest.raises(RuntimeError, match="metadata mismatch"):
+        load_quantized_projection(
+            module,
+            artifact,
+            is_wclip=True,
+            quip_params={"w_bits": 4, "w_groupsize": 128},
+        )
+
+
+def test_tiny_custom_llama_uses_dense_wclip_projections_and_runs_forward():
+    config = LlamaConfig(
+        vocab_size=256,
+        hidden_size=128,
+        intermediate_size=256,
+        num_hidden_layers=1,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        max_position_embeddings=64,
+    )
+    config.torch_dtype = torch.float32
+    config.quip_params = {
+        "quantizer": "realq_wclip",
+        "td_x": 1,
+        "td_y": 128,
+        "L": 16,
+        "K": 4,
+        "V": 1,
+        "tlut_bits": 0,
+        "decode_mode": "unused",
+        "skip_list": [],
+    }
+    model = LlamaForCausalLM(config).eval()
+    layer = model.model.layers[0]
+    assert type(layer.self_attn.q_proj) is nn.Linear
+    assert type(layer.mlp.down_proj) is nn.Linear
+    with torch.no_grad():
+        logits = model(
+            torch.randint(0, config.vocab_size, (1, 8)),
+            use_cache=False,
+        ).logits
+    assert logits.shape == (1, 8, config.vocab_size)
+    assert torch.isfinite(logits).all()
