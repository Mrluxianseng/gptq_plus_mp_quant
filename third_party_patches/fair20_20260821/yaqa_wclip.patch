@@ -0,0 +1,157 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 3 ]]; then
+  echo "usage: $0 <1b|3b> <cuda-visible-list> <campaign-output-root>"
+  exit 2
+fi
+
+MODEL_SIZE=$1
+VISIBLE_GPUS=$2
+OUTPUT_ROOT=$3
+
+WORKSPACE=${REALQ_WORKSPACE:-/minimax-avatar-new/zhangqian/realq/gptq_plus}
+RUN_QUANTIZE=${WORKSPACE}/YAQA_wclip/scripts/run_quantize.sh
+SHARED_ROOT=${WORKSPACE}/output/yaqa_compare_20260725/j-8j1en3m0aq
+
+case "${MODEL_SIZE}" in
+  1b|3b) ;;
+  *) echo "unsupported model size: ${MODEL_SIZE}"; exit 2 ;;
+esac
+
+RAW_ROOT=${OUTPUT_ROOT}/raw
+LOG_ROOT=${OUTPUT_ROOT}/logs
+STATE_ROOT=${OUTPUT_ROOT}/state
+
+mkdir -p "${RAW_ROOT}" "${LOG_ROOT}" "${STATE_ROOT}"
+
+atomic_state() {
+  local state_path=$1
+  shift
+  {
+    printf 'model_size=%s\n' "${MODEL_SIZE}"
+    printf 'visible_gpus=%s\n' "${VISIBLE_GPUS}"
+    printf '%s\n' "$@"
+  } > "${state_path}.tmp"
+  mv "${state_path}.tmp" "${state_path}"
+}
+
+run_one() {
+  local setting=$1
+  local run_id=$2
+  local hessian_dir=$3
+  local hessian_validation=$4
+  local output_dir=${RAW_ROOT}/${run_id}
+  local log_path=${LOG_ROOT}/${run_id}.quantize.log
+  local state_path=${STATE_ROOT}/${run_id}.quantize.state
+  local started_at
+  local finished_at
+  local start_epoch
+  local end_epoch
+  local elapsed_seconds
+  local rc
+
+  if [[ -e "${output_dir}" || -L "${output_dir}" ]]; then
+    echo "refusing to reuse output path: ${output_dir}" >&2
+    exit 2
+  fi
+
+  started_at=$(date --iso-8601=seconds)
+  start_epoch=$(date +%s)
+  atomic_state "${state_path}" \
+    "setting=${setting}" \
+    "status=running" \
+    "started_at=${started_at}" \
+    "output_dir=${output_dir}" \
+    "log_path=${log_path}"
+
+  set +e
+  "${RUN_QUANTIZE}" \
+    "${MODEL_SIZE}" \
+    "${setting}" \
+    "${VISIBLE_GPUS}" \
+    "${hessian_dir}" \
+    "${hessian_validation}" \
+    "${output_dir}" \
+    > "${log_path}" 2>&1
+  rc=$?
+  set -e
+
+  finished_at=$(date --iso-8601=seconds)
+  end_epoch=$(date +%s)
+  elapsed_seconds=$((end_epoch - start_epoch))
+
+  if [[ ${rc} -eq 0 ]]; then
+    atomic_state "${state_path}" \
+      "setting=${setting}" \
+      "status=completed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=${elapsed_seconds}" \
+      "exit_code=0" \
+      "output_dir=${output_dir}" \
+      "log_path=${log_path}"
+  else
+    atomic_state "${state_path}" \
+      "setting=${setting}" \
+      "status=failed" \
+      "started_at=${started_at}" \
+      "finished_at=${finished_at}" \
+      "elapsed_seconds=${elapsed_seconds}" \
+      "exit_code=${rc}" \
+      "output_dir=${output_dir}" \
+      "log_path=${log_path}"
+    echo "${run_id} failed with exit code ${rc}; see ${log_path}" >&2
+    return "${rc}"
+  fi
+}
+
+HESSIAN_A16=${SHARED_ROOT}/hessians/llama32_${MODEL_SIZE}_a16kv16_n256_ieeefp32v1
+VALIDATION_A16=${SHARED_ROOT}/validation/llama32_${MODEL_SIZE}_a16kv16_n256_ieeefp32v1.json
+HESSIAN_AWARE=${SHARED_ROOT}/hessians/llama32_${MODEL_SIZE}_a4kv4_aware_n256_ieeefp32v1
+VALIDATION_AWARE=${SHARED_ROOT}/validation/llama32_${MODEL_SIZE}_a4kv4_aware_n256_ieeefp32v1.json
+
+LANE_STARTED_AT=$(date --iso-8601=seconds)
+
+finish_lane_state() {
+  local rc=$?
+  if [[ ${rc} -ne 0 ]]; then
+    atomic_state "${STATE_ROOT}/lane_${MODEL_SIZE}.state" \
+      "status=failed" \
+      "started_at=${LANE_STARTED_AT}" \
+      "finished_at=$(date --iso-8601=seconds)" \
+      "exit_code=${rc}"
+  fi
+}
+
+trap finish_lane_state EXIT
+
+atomic_state "${STATE_ROOT}/lane_${MODEL_SIZE}.state" \
+  "status=running" \
+  "started_at=${LANE_STARTED_AT}"
+
+run_one \
+  W4A16KV16 \
+  "llama32_${MODEL_SIZE}_w4a16kv16_formal1" \
+  "${HESSIAN_A16}" \
+  "${VALIDATION_A16}"
+
+run_one \
+  W3A16KV16 \
+  "llama32_${MODEL_SIZE}_w3a16kv16_formal1" \
+  "${HESSIAN_A16}" \
+  "${VALIDATION_A16}"
+
+run_one \
+  W2A4KV4 \
+  "llama32_${MODEL_SIZE}_w2a4kv4_aware_formal1" \
+  "${HESSIAN_AWARE}" \
+  "${VALIDATION_AWARE}"
+
+atomic_state "${STATE_ROOT}/lane_${MODEL_SIZE}.state" \
+  "status=completed" \
+  "started_at=${LANE_STARTED_AT}" \
+  "finished_at=$(date --iso-8601=seconds)" \
+  "exit_code=0"
+
+trap - EXIT
