+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 6 ]]; then
+  echo "usage: $0 <1b|3b> <W4A16KV16|W3A16KV16|W2A4KV4> <raw-dir> <hf-dir> <report.json> <cuda-visible-gpu>"
+  exit 2
+fi
+
+MODEL_SIZE=$1
+SETTING=$2
+RAW_DIR=$3
+HF_DIR=$4
+REPORT=$5
+VISIBLE_GPU=$6
+WORKSPACE=${REALQ_WORKSPACE:-/minimax-avatar-new/zhangqian/realq/gptq_plus}
+PYTHON_BIN=${PYTHON_BIN:-${WORKSPACE}/.venv/bin/python}
+
+case "${MODEL_SIZE}" in
+  1b) MODEL_PATH=${WORKSPACE}/modelzoo/Llama/Llama-3.2-1B ;;
+  3b) MODEL_PATH=${WORKSPACE}/modelzoo/Llama/Llama-3.2-3B ;;
+  *) echo "unsupported model size: ${MODEL_SIZE}"; exit 2 ;;
+esac
+
+cd "${WORKSPACE}"
+export CUDA_VISIBLE_DEVICES="${VISIBLE_GPU}"
+export PYTHONPATH="${WORKSPACE}/YAQA_wclip:${WORKSPACE}:${WORKSPACE}/YAQA_wclip/qtip-kernels"
+
+exec "${PYTHON_BIN}" \
+  "${WORKSPACE}/YAQA_wclip/eval/validate_hfized_wclip.py" \
+  --model "${MODEL_PATH}" \
+  --setting "${SETTING}" \
+  --raw-dir "${RAW_DIR}" \
+  --hf-dir "${HF_DIR}" \
+  --output "${REPORT}"
