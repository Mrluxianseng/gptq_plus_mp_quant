+
+
+def _is_number(value: Any) -> bool:
+    return type(value) in (int, float) and math.isfinite(float(value))
+
+
+def _require_sha256(value: Any, label: str) -> str:
+    _require(
+        isinstance(value, str) and SHA256_RE.fullmatch(value) is not None,
+        f"{label}: expected a lowercase SHA256, got {value!r}",
+    )
+    return value
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+class _HashCache:
+    def __init__(self) -> None:
+        self._values: dict[Path, str] = {}
+
+    def get(self, path: Path) -> str:
+        resolved = path.resolve()
+        if resolved not in self._values:
+            self._values[resolved] = sha256_file(resolved)
+        return self._values[resolved]
+
+
+def _load_json(path: Path, label: str) -> dict[str, Any]:
+    _require(path.is_file() and not path.is_symlink(), f"{label}: missing file {path}")
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise AuditError(f"{label}: cannot read JSON {path}: {exc}") from exc
+    _require(isinstance(value, dict), f"{label}: top-level JSON must be an object")
+    return value
+
+
+def _same_path(actual: Any, expected: Path, label: str) -> None:
+    _require(isinstance(actual, str) and actual, f"{label}: missing path")
+    _require(
+        Path(actual).resolve() == expected.resolve(),
+        f"{label}: path mismatch: {actual!r} != {str(expected.resolve())!r}",
+    )
+
+
+def _require_directory(path: Path, label: str) -> None:
+    _require(path.is_dir() and not path.is_symlink(), f"{label}: missing directory {path}")
+
+
+def _require_exact_top_level(
+    directory: Path,
+    expected_names: set[str],
+    *,
+    directories: bool,
+    label: str,
+) -> None:
+    _require_directory(directory, label)
+    actual = {
+        child.name
+        for child in directory.iterdir()
+        if child.is_dir() if directories
+    } if directories else {
+        child.name
+        for child in directory.iterdir()
+        if child.is_file()
+    }
+    _require(
+        actual == expected_names,
+        f"{label}: artifact set mismatch; "
+        f"missing={sorted(expected_names - actual)}, "
+        f"extra={sorted(actual - expected_names)}",
+    )
+
+
+def _record_map(
+    records: Any,
+    expected_paths: set[Path],
+    *,
+    label: str,
+) -> dict[Path, dict[str, Any]]:
+    _require(isinstance(records, list), f"{label}: records must be a list")
+    by_path: dict[Path, dict[str, Any]] = {}
+    for index, record in enumerate(records):
+        _require(isinstance(record, dict), f"{label}[{index}]: record must be an object")
+        raw_path = record.get("path")
+        _require(
+            isinstance(raw_path, str) and raw_path,
+            f"{label}[{index}]: missing path",
+        )
+        path = Path(raw_path).resolve()
+        _require(path not in by_path, f"{label}: duplicate path {path}")
+        by_path[path] = record
+    resolved_expected = {path.resolve() for path in expected_paths}
+    _require(
+        set(by_path) == resolved_expected,
+        f"{label}: record path set mismatch; "
+        f"missing={sorted(str(p) for p in resolved_expected - set(by_path))}, "
+        f"extra={sorted(str(p) for p in set(by_path) - resolved_expected)}",
+    )
+    return by_path
+
+
+def _validate_file_record(
+    path: Path,
+    record: Mapping[str, Any],
+    *,
+    label: str,
+    hashes: _HashCache,
+    verify_hash: bool,
+) -> None:
+    _require(
+        path.is_file() and not path.is_symlink(),
+        f"{label}: missing regular file {path}",
+    )
+    size = path.stat().st_size
+    _require(
+        _is_int(record.get("bytes"))
+        and int(record["bytes"]) == size
+        and size > 0,
+        f"{label}: byte-size mismatch for {path}",
+    )
+    expected_sha = _require_sha256(record.get("sha256"), f"{label}.sha256")
+    if verify_hash:
+        _require(
+            hashes.get(path) == expected_sha,
+            f"{label}: SHA256 mismatch for {path}",
+        )
+
+
+def _expected_runtime(spec: RunSpec) -> dict[str, Any]:
+    if spec.setting != "W2A4KV4":
+        return {"mode": "n/a"}
+    return {
+        "mode": "deployment",
+        "decoder_layers": spec.layer_count,
+        "activation_input_sites": 7 * spec.layer_count,
+        "value_output_sites": spec.layer_count,
+        "post_rope_k_sites": spec.layer_count,
+        "a_bits": 4,
+        "k_bits": 4,
+        "v_bits": 4,
+        "groupsize": -1,
+        "symmetric": True,
+        "clip_ratio": 0.9,
+        "query_quantized": False,
+        "extra_qk_hadamard": False,
+    }
+
+
+def _expected_hessian_akv(spec: RunSpec) -> dict[str, Any]:
+    if spec.setting != "W2A4KV4":
+        return {
+            "mode": "n/a",
+            "decoder_layers": spec.layer_count,
+            "activation_input_sites": 0,
+            "value_output_sites": 0,
+            "post_rope_k_sites": 0,
+            "a_bits": 16,
+            "k_bits": 16,
+            "v_bits": 16,
+            "groupsize": -1,
+            "symmetric": True,
+            "clip_ratio": 1.0,
+            "query_quantized": False,
+            "extra_qk_hadamard": False,
+        }
+    expected = _expected_runtime(spec)
+    expected["mode"] = "aware"
+    return expected
+
+
+def _validate_hessian_provenance(
+    report: Mapping[str, Any],
+    spec: RunSpec,
+    model_path: Path,
+    calibration_path: Path,
+    expected_token_sha256: str,
+    expected_hessian_sha256: Mapping[tuple[str, str], str],
+    hashes: _HashCache,
+    *,
+    verify_all_hashes: bool,
+) -> dict[str, Any]:
+    validation_path = Path(str(report.get("hessian_validation", ""))).resolve()
+    manifest_path = Path(str(report.get("hessian_manifest", ""))).resolve()
+    _require(validation_path.is_file(), f"{spec.run_id}: missing Hessian validation")
+    _require(manifest_path.is_file(), f"{spec.run_id}: missing Hessian manifest")
+
+    recorded_validation_sha = _require_sha256(
+        report.get("hessian_validation_sha256"),
+        f"{spec.run_id}.hessian_validation_sha256",
+    )
+    expected_sha = expected_hessian_sha256[(spec.model_size, spec.hessian_mode)]
+    _require(
+        recorded_validation_sha == expected_sha,
+        f"{spec.run_id}: unexpected Hessian validation SHA256",
+    )
+    _require(
+        hashes.get(validation_path) == expected_sha,
+        f"{spec.run_id}: live Hessian validation SHA256 mismatch",
+    )
+    recorded_manifest_sha = _require_sha256(
+        report.get("hessian_manifest_sha256"),
+        f"{spec.run_id}.hessian_manifest_sha256",
+    )
+    _require(
+        hashes.get(manifest_path) == recorded_manifest_sha,
+        f"{spec.run_id}: live Hessian manifest SHA256 mismatch",
+    )
+
+    validation = _load_json(
+        validation_path, f"{spec.run_id}.hessian_validation"
+    )
+    _require(
+        validation.get("schema_version") == 2
+        and validation.get("status") == "validated"
+        and validation.get("layer_count") == spec.layer_count,
+        f"{spec.run_id}: Hessian validation header mismatch",
+    )
+    _same_path(validation.get("model"), model_path, f"{spec.run_id}.hessian.model")
+    hessian_dir = Path(str(validation.get("hessian_dir", ""))).resolve()
+    _require_directory(hessian_dir, f"{spec.run_id}.hessian_dir")
+    _require(
+        manifest_path == (hessian_dir / "manifest.json").resolve(),
+        f"{spec.run_id}: Hessian manifest path mismatch",
+    )
+
+    manifest = validation.get("manifest")
+    _require(isinstance(manifest, dict), f"{spec.run_id}: missing Hessian manifest")
+    manifest_file = _load_json(manifest_path, f"{spec.run_id}.hessian_manifest")
+    _require(
+        manifest_file == manifest,
+        f"{spec.run_id}: Hessian manifest file/report mismatch",
+    )
+    _same_path(manifest.get("model"), model_path, f"{spec.run_id}.manifest.model")
+    _same_path(
+        manifest.get("save_path"), hessian_dir, f"{spec.run_id}.manifest.save_path"
+    )
+    _same_path(
+        manifest.get("calib_tokens_path"),
+        calibration_path,
+        f"{spec.run_id}.manifest.calib_tokens_path",
+    )
+    _require(
+        manifest.get("schema_version") == 2
+        and manifest.get("calib_tokens_sha256") == expected_token_sha256
+        and manifest.get("n_seqs") == 256
+        and manifest.get("ctx_size") == 2048
+        and manifest.get("hessian_sketch") == "B"
+        and manifest.get("fp64_accum_effective") is False
+        and manifest.get("torch_float32_matmul_precision") == "highest"
+        and manifest.get("cuda_matmul_fp32_precision") == "ieee"
+        and manifest.get("akv") == _expected_hessian_akv(spec),
+        f"{spec.run_id}: Hessian manifest protocol mismatch",
+    )
+    summary = {
+        "mode": spec.hessian_mode,
+        "validation_report": str(validation_path),
+        "validation_report_sha256": expected_sha,
+        "manifest": str(manifest_path),
+        "manifest_sha256": recorded_manifest_sha,
+        "akv": manifest["akv"],
+        "tensor_hashes_verified": verify_all_hashes,
+    }
+    if verify_all_hashes:
+        tensor_paths = {
+            hessian_dir / f"{layer}_{projection}_{side}.pt"
+            for layer in range(spec.layer_count)
+            for projection in PROJECTIONS
+            for side in ("hin", "hout")
+        }
+        expected_live_paths = {
+            path.resolve() for path in tensor_paths | {manifest_path}
+        }
+        live_paths = {
+            path.resolve() for path in hessian_dir.iterdir() if path.is_file()
+        }
+        _require(
+            live_paths == expected_live_paths,
+            f"{spec.run_id}: Hessian live file set mismatch; "
+            f"missing={sorted(str(p) for p in expected_live_paths - live_paths)}, "
+            f"extra={sorted(str(p) for p in live_paths - expected_live_paths)}",
+        )
+        tensor_records = _record_map(
+            validation.get("tensors"),
+            tensor_paths,
+            label=f"{spec.run_id}.hessian_tensors",
+        )
+        _require(
+            validation.get("tensor_count") == len(tensor_paths),
+            f"{spec.run_id}: Hessian tensor_count mismatch",
+        )
+        total_bytes = 0
+        for path, record in tensor_records.items():
+            _validate_file_record(
+                path,
+                record,
+                label=f"{spec.run_id}.hessian_tensor",
+                hashes=hashes,
+                verify_hash=True,
+            )
+            total_bytes += path.stat().st_size
+        _require(
+            validation.get("total_bytes") == total_bytes,
+            f"{spec.run_id}: Hessian total_bytes mismatch",
+        )
+        summary["tensor_count"] = len(tensor_records)
+        summary["tensor_total_bytes"] = total_bytes
+    return summary
+
+
+def _validate_hf_config(
+    config_path: Path,
+    spec: RunSpec,
+    calibration_path: Path,
+    expected_token_sha256: str,
+    hessian: Mapping[str, Any],
+) -> None:
+    config = _load_json(config_path, f"{spec.run_id}.hf_config")
+    _require(
+        config.get("num_hidden_layers") == spec.layer_count,
+        f"{spec.run_id}: HF layer count mismatch",
+    )
+    params = config.get("quip_params")
+    _require(isinstance(params, dict), f"{spec.run_id}: missing HF quip_params")
+    expected_akv_bits = 4 if spec.setting == "W2A4KV4" else 16
+    expected_akv_clip = 0.9 if spec.setting == "W2A4KV4" else 1.0
+    expected_aware = spec.setting == "W2A4KV4"
+    required = {
+        "quantizer": "realq_wclip",
+        "setting": spec.setting,
+        "codebook": "realq_wclip",
+        "K": spec.weight_bits,
+        "V": 1,
+        "td_x": 1,
+        "td_y": 128,
+        "w_bits": spec.weight_bits,
+        "w_groupsize": 128,
+        "w_sym": True,
+        "w_clip": True,
+        "w_group_axis": "natural_input_columns",
+        "w_group_param_layout": "compact",
+        "dense_fake_quant": True,
+        "runtime_weight_representation": "dense_fake_quant",
+        "packed": False,
+        "lowbit_kernel": False,
+        "a_bits": expected_akv_bits,
+        "k_bits": expected_akv_bits,
+        "v_bits": expected_akv_bits,
+        "akv_groupsize": -1,
+        "akv_clip_ratio": expected_akv_clip,
+        "akv_aware_hessian": expected_aware,
+        "calib_tokens_path": str(calibration_path),
+        "calib_tokens_sha256": expected_token_sha256,
+        "calib_n_seqs": 256,
+        "calib_ctx_size": 2048,
+        "hessian_validation_path": hessian["validation_report"],
+        "hessian_validation_sha256": hessian["validation_report_sha256"],
+        "hessian_manifest_path": hessian["manifest"],
+        "hessian_manifest_sha256": hessian["manifest_sha256"],
+        "skip_list": [],
+    }
+    mismatch = {
+        key: (params.get(key), expected)
+        for key, expected in required.items()
+        if params.get(key) != expected
+    }
+    _require(not mismatch, f"{spec.run_id}: HF quip_params mismatch: {mismatch}")
+
+
+def _validate_validation_report(
+    campaign_root: Path,
+    spec: RunSpec,
+    model_path: Path,
+    calibration_path: Path,
+    expected_token_sha256: str,
+    expected_hessian_sha256: Mapping[tuple[str, str], str],
+    hashes: _HashCache,
+    *,
+    verify_hf_hashes: bool,
+    verify_all_hashes: bool,
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    raw_dir = (campaign_root / "raw" / spec.run_id).resolve()
+    hf_dir = (campaign_root / "hf" / spec.run_id).resolve()
+    validation_path = (
+        campaign_root / "validation" / f"{spec.run_id}.json"
+    ).resolve()
+    _require_directory(raw_dir, f"{spec.run_id}.raw")
+    _require_directory(hf_dir, f"{spec.run_id}.hf")
+    report = _load_json(validation_path, f"{spec.run_id}.validation")
+
+    _require(
+        report.get("schema_version") == 2
+        and report.get("status") == "validated"
+        and report.get("setting") == spec.setting
+        and report.get("weight_quantizer") == "realq_wclip"
+        and report.get("weight_bits") == spec.weight_bits
+        and report.get("weight_groupsize") == 128
+        and report.get("runtime_weight_representation") == "dense_fake_quant"
+        and report.get("packed") is False
+        and report.get("lowbit_kernel") is False
+        and report.get("layer_count") == spec.layer_count
+        and report.get("projection_count") == 7 * spec.layer_count
+        and report.get("runtime_akv") == _expected_runtime(spec)
+        and report.get("integer_reconstruction_verified") is True
+        and report.get("reload_deterministic") is True,
+        f"{spec.run_id}: validation protocol/header mismatch",
+    )
+    _same_path(report.get("model"), model_path, f"{spec.run_id}.validation.model")
+    _same_path(report.get("raw_dir"), raw_dir, f"{spec.run_id}.validation.raw_dir")
+    _same_path(report.get("hf_dir"), hf_dir, f"{spec.run_id}.validation.hf_dir")
+    _same_path(
+        report.get("calib_tokens_path"),
+        calibration_path,
+        f"{spec.run_id}.validation.calib_tokens_path",
+    )
+    _require(
+        report.get("calib_tokens_sha256") == expected_token_sha256,
+        f"{spec.run_id}: calibration token SHA256 mismatch",
+    )
+
+    smoke = report.get("smoke_logits_sha256")
+    _require(
+        isinstance(smoke, dict)
+        and set(smoke) == {"one_token", "thirty_two_tokens"},
+        f"{spec.run_id}: smoke fingerprint set mismatch",
+    )
+    for name, value in smoke.items():
+        _require_sha256(value, f"{spec.run_id}.smoke.{name}")
+
+    hessian = _validate_hessian_provenance(
+        report,
+        spec,
+        model_path,
+        calibration_path,
+        expected_token_sha256,
+        expected_hessian_sha256,
+        hashes,
+        verify_all_hashes=verify_all_hashes,
+    )
+
+    raw_paths = {raw_dir / "config.pt"}
+    raw_paths.update(
+        raw_dir / f"{layer}_layernorm.pt"
+        for layer in range(spec.layer_count)
+    )
+    raw_paths.update(
+        raw_dir / f"{layer}_{projection}.pt"
+        for layer in range(spec.layer_count)
+        for projection in PROJECTIONS
+    )
+    live_raw_paths = {
+        path.resolve() for path in raw_dir.iterdir() if path.is_file()
+    }
+    _require(
+        live_raw_paths == {path.resolve() for path in raw_paths},
+        f"{spec.run_id}: live raw file set mismatch",
+    )
+
+    raw_config = report.get("raw_config")
+    _require(isinstance(raw_config, dict), f"{spec.run_id}: missing raw config record")
+    raw_config_path = (raw_dir / "config.pt").resolve()
+    _same_path(raw_config.get("path"), raw_config_path, f"{spec.run_id}.raw_config")
+    _validate_file_record(
+        raw_config_path,
+        raw_config,
+        label=f"{spec.run_id}.raw_config",
+        hashes=hashes,
+        verify_hash=True,
+    )
+
+    layernorm_paths = {
+        raw_dir / f"{layer}_layernorm.pt" for layer in range(spec.layer_count)
+    }
+    layernorm_records = _record_map(
+        report.get("raw_layernorm_files"),
+        layernorm_paths,
+        label=f"{spec.run_id}.raw_layernorm_files",
+    )
+    for path, record in layernorm_records.items():
+        _validate_file_record(
+            path,
+            record,
+            label=f"{spec.run_id}.raw_layernorm",
+            hashes=hashes,
+            verify_hash=True,
+        )
+
+    projection_paths = {
+        raw_dir / f"{layer}_{projection}.pt"
+        for layer in range(spec.layer_count)
+        for projection in PROJECTIONS
+    }
+    projection_records = _record_map(
+        report.get("raw_projection_files"),
+        projection_paths,
+        label=f"{spec.run_id}.raw_projection_files",
+    )
+    qmin = -(2 ** (spec.weight_bits - 1))
+    qmax = 2 ** (spec.weight_bits - 1) - 1
+    for path, record in projection_records.items():
+        _validate_file_record(
+            path,
+            record,
+            label=f"{spec.run_id}.raw_projection",
+            hashes=hashes,
+            verify_hash=verify_all_hashes,
+        )
+        _require(
+            record.get("dense_reconstruction_exact") is True
+            and _is_int(record.get("code_min"))
+            and _is_int(record.get("code_max"))
+            and qmin <= record["code_min"] <= record["code_max"] <= qmax
+            and isinstance(record.get("qweight_shape"), list)
+            and len(record["qweight_shape"]) == 2
+            and isinstance(record.get("scale_shape"), list)
+            and len(record["scale_shape"]) == 2,
+            f"{spec.run_id}: invalid projection validation record for {path}",
+        )
+
+    live_hf_paths = {
+        path.resolve() for path in hf_dir.rglob("*") if path.is_file()
+    }
+    hf_records = _record_map(
+        report.get("hf_files"),
+        live_hf_paths,
+        label=f"{spec.run_id}.hf_files",
+    )
+    required_hf_names = {"config.json", "tokenizer.json", "tokenizer_config.json"}
+    actual_hf_names = {path.name for path in live_hf_paths}
+    _require(
+        required_hf_names.issubset(actual_hf_names)
+        and any(name.endswith(".safetensors") for name in actual_hf_names),
+        f"{spec.run_id}: incomplete HF tree",
+    )
+    for path, record in hf_records.items():
+        _validate_file_record(
+            path,
+            record,
+            label=f"{spec.run_id}.hf_file",
+            hashes=hashes,
+            verify_hash=verify_hf_hashes,
+        )
+    _validate_hf_config(
+        hf_dir / "config.json",
+        spec,
+        calibration_path,
+        expected_token_sha256,
+        hessian,
+    )
+
+    validation_sha = hashes.get(validation_path)
+    return report, {
+        "raw_dir": str(raw_dir),
+        "raw_file_count": len(raw_paths),
+        "hf_dir": str(hf_dir),
+        "hf_file_count": len(hf_records),
+        "validation_report": str(validation_path),
+        "validation_report_sha256": validation_sha,
+        "hessian": hessian,
+        "runtime_akv": report["runtime_akv"],
+        "smoke_logits_sha256": smoke,
+    }
+
+
+def _read_state(path: Path, label: str) -> dict[str, str]:
+    _require(path.is_file() and not path.is_symlink(), f"{label}: missing state {path}")
+    state: dict[str, str] = {}
+    for line_number, raw_line in enumerate(
+        path.read_text(encoding="utf-8").splitlines(), start=1
+    ):
+        if not raw_line:
+            continue
+        _require("=" in raw_line, f"{label}:{line_number}: malformed state line")
+        key, value = raw_line.split("=", 1)
+        _require(key and key not in state, f"{label}:{line_number}: duplicate state key")
+        state[key] = value
+    return state
+
+
+def _require_completed_state(
+    path: Path,
+    *,
+    label: str,
+    required: Mapping[str, str],
+    require_elapsed: bool,
+) -> dict[str, Any]:
+    state = _read_state(path, label)
+    _require(
+        state.get("status") == "completed" and state.get("exit_code") == "0",
+        f"{label}: state is not completed with exit_code=0",
+    )
+    mismatch = {
+        key: (state.get(key), expected)
+        for key, expected in required.items()
+        if state.get(key) != expected
+    }
+    _require(not mismatch, f"{label}: state metadata mismatch: {mismatch}")
+    _require(
+        bool(state.get("started_at")) and bool(state.get("finished_at")),
+        f"{label}: state lacks start/finish timestamps",
+    )
+    result: dict[str, Any] = {
+        "path": str(path),
+        "status": "completed",
+        "started_at": state["started_at"],
+        "finished_at": state["finished_at"],
+        "exit_code": 0,
+    }
+    if require_elapsed:
+        try:
+            elapsed = int(state.get("elapsed_seconds", ""))
+        except ValueError as exc:
+            raise AuditError(f"{label}: invalid elapsed_seconds") from exc
+        _require(elapsed >= 0, f"{label}: negative elapsed_seconds")
+        result["elapsed_seconds"] = elapsed
+    return result
+
+
+def _validate_states(
+    campaign_root: Path,
+    spec: RunSpec,
+    artifact: Mapping[str, Any],
+    result_path: Path,
+) -> dict[str, Any]:
+    state_root = campaign_root / "state"
+    log_root = campaign_root / "logs"
+    _require_directory(state_root, "campaign.state")
+    _require_directory(log_root, "campaign.logs")
+    visible_gpus = "0,1,2,3" if spec.model_size == "1b" else "4,5,6,7"
+    states: dict[str, Any] = {}
+    stage_requirements = {
+        "quantize": {
+            "model_size": spec.model_size,
+            "visible_gpus": visible_gpus,
+            "setting": spec.setting,
+            "output_dir": artifact["raw_dir"],
+            "log_path": str((log_root / f"{spec.run_id}.quantize.log").resolve()),
+        },
+        "hfize": {
+            "model_size": spec.model_size,
+            "visible_gpus": visible_gpus,
+            "raw_dir": artifact["raw_dir"],
+            "hf_dir": artifact["hf_dir"],
+            "log_path": str((log_root / f"{spec.run_id}.hfize.log").resolve()),
+        },
+        "validate": {
+            "model_size": spec.model_size,
+            "visible_gpus": visible_gpus,
+            "setting": spec.setting,
+            "report": artifact["validation_report"],
+            "log_path": str((log_root / f"{spec.run_id}.validate.log").resolve()),
+        },
+        "evaluate": {
+            "model_size": spec.model_size,
+            "visible_gpus": visible_gpus,
+            "setting": spec.setting,
+            "result": str(result_path.resolve()),
+            "log_path": str((log_root / f"{spec.run_id}.evaluate.log").resolve()),
+        },
+    }
+    for stage, required in stage_requirements.items():
+        state_path = state_root / f"{spec.run_id}.{stage}.state"
+        states[stage] = _require_completed_state(
+            state_path,
+            label=f"{spec.run_id}.{stage}",
+            required=required,
+            require_elapsed=True,
+        )
+        log_path = Path(required["log_path"])
+        _require(
+            log_path.is_file() and log_path.stat().st_size > 0,
+            f"{spec.run_id}.{stage}: missing/non-empty log {log_path}",
+        )
+    quant_seconds = states["quantize"]["elapsed_seconds"]
+    states["quantize"]["gpu_count"] = 4
+    states["quantize"]["gpu_hours"] = quant_seconds * 4 / 3600.0
+    return states
+
+
+def _validate_result(
+    campaign_root: Path,
+    spec: RunSpec,
+    model_path: Path,
+    artifact: Mapping[str, Any],
+    evaluator_path: Path,
+    hashes: _HashCache,
+    *,
+    verify_all_hashes: bool,
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    result_path = (campaign_root / "results" / f"{spec.run_id}.json").resolve()
+    result = _load_json(result_path, f"{spec.run_id}.result")
+    _require(
+        result.get("schema_version") == 1
+        and result.get("status") == "evaluated"
+        and result.get("setting") == spec.setting,
+        f"{spec.run_id}: result header mismatch",
+    )
+    _same_path(result.get("model"), model_path, f"{spec.run_id}.result.model")
+    _same_path(result.get("hf_dir"), Path(artifact["hf_dir"]), f"{spec.run_id}.result.hf")
+    _same_path(
+        result.get("hf_validation"),
+        Path(artifact["validation_report"]),
+        f"{spec.run_id}.result.validation",
+    )
+    _require(
+        result.get("hf_validation_sha256")
+        == artifact["validation_report_sha256"],
+        f"{spec.run_id}: result is not bound to current validation report",
+    )
+
+    evaluator = result.get("evaluator")
+    _require(isinstance(evaluator, dict), f"{spec.run_id}: missing evaluator metadata")
+    _same_path(evaluator.get("path"), evaluator_path, f"{spec.run_id}.evaluator.path")
+    _require(
+        evaluator.get("paper_tasks") == list(PAPER_TASKS)
+        and evaluator.get("sha256") == hashes.get(evaluator_path),
+        f"{spec.run_id}: evaluator/task provenance mismatch",
+    )
+
+    reference = result.get("reference")
+    _require(isinstance(reference, dict), f"{spec.run_id}: missing reference metadata")
+    cache_path = Path(str(reference.get("cache_path", ""))).resolve()
+    _require(
+        cache_path.is_file()
+        and not cache_path.is_symlink()
+        and cache_path.stat().st_size > 0
+        and reference.get("required_cache_hit") is True,
+        f"{spec.run_id}: invalid/missing required FP reference cache",
+    )
+    _require_sha256(reference.get("cache_sha256"), f"{spec.run_id}.reference.cache")
+    if verify_all_hashes:
+        _require(
+            hashes.get(cache_path) == reference["cache_sha256"],
+            f"{spec.run_id}: FP reference cache SHA256 mismatch",
+        )
+    metadata = reference.get("metadata")
+    _require(isinstance(metadata, dict), f"{spec.run_id}: missing reference metadata")
+    hidden_shape = metadata.get("hidden_states_shape")
+    _require(
+        metadata.get("schema_version") == 2
+        and metadata.get("dataset") == "wikitext2"
+        and metadata.get("eval_seq_len") == 2048
+        and metadata.get("checkpoint_is_rotated") is False
+        and metadata.get("rotation_identity")
+        == "generated_hadamard:rotation_seed=0"
+        and isinstance(hidden_shape, list)
+        and len(hidden_shape) == 3
+        and _is_int(hidden_shape[0])
+        and hidden_shape[0] > 0
+        and hidden_shape[1] == 2048
+        and _is_int(hidden_shape[2])
+        and hidden_shape[2] > 0,
+        f"{spec.run_id}: reference is not canonical WikiText2/2048 metadata",
+    )
+    eval_tokens_identity = _require_sha256(
+        metadata.get("eval_tokens_identity"),
+        f"{spec.run_id}.reference.eval_tokens_identity",
+    )
+
+    metrics = result.get("metrics")
+    _require(
+        isinstance(metrics, dict) and set(metrics) == {"wikitext2", "lm_eval"},
+        f"{spec.run_id}: result metric set mismatch",
+    )
+    wiki = metrics["wikitext2"]
+    _require(
+        isinstance(wiki, dict)
+        and set(wiki)
+        == {
+            "kl_raw",
+            "kl_x100",
+            "ppl",
+            "split",
+            "sequence_length",
+            "kl_direction",
+            "kl_full_vocabulary_fp32",
+        }
+        and wiki.get("split") == "test"
+        and wiki.get("sequence_length") == 2048
+        and wiki.get("kl_direction") == "KL(FP||quantized)"
+        and wiki.get("kl_full_vocabulary_fp32") is True
+        and _is_number(wiki.get("ppl"))
+        and float(wiki["ppl"]) > 0
+        and _is_number(wiki.get("kl_raw"))
+        and float(wiki["kl_raw"]) >= 0
+        and _is_number(wiki.get("kl_x100"))
+        and float(wiki["kl_x100"]) >= 0
+        and math.isclose(
+            float(wiki["kl_x100"]),
+            float(wiki["kl_raw"]) * 100.0,
+            rel_tol=1e-12,
+            abs_tol=1e-12,
+        ),
+        f"{spec.run_id}: invalid WikiText2 PPL/KL metrics",
+    )
+
+    lm_eval = metrics["lm_eval"]
+    _require(
+        isinstance(lm_eval, dict)
+        and set(lm_eval)
+        == {
+            "version",
+            "num_fewshot",
+            "apply_chat_template",
+            "batch_size",
+            "tasks",
+            "acc_avg",
+        }
+        and lm_eval.get("version") == "0.4.4"
+        and lm_eval.get("num_fewshot") == 0
+        and lm_eval.get("apply_chat_template") is False
+        and lm_eval.get("batch_size") == 32,
+        f"{spec.run_id}: lm-eval interface mismatch",
+    )
+    tasks = lm_eval.get("tasks")
+    _require(
+        isinstance(tasks, dict) and set(tasks) == set(PAPER_TASKS),
+        f"{spec.run_id}: lm-eval task key set mismatch",
+    )
+    _require(
+        all(_is_number(value) and 0 <= float(value) <= 100 for value in tasks.values()),
+        f"{spec.run_id}: non-finite/out-of-range lm-eval task value",
+    )
+    expected_average = round(
+        sum(float(tasks[name]) for name in PAPER_TASKS) / len(PAPER_TASKS), 2
+    )
+    _require(
+        _is_number(lm_eval.get("acc_avg"))
+        and math.isclose(
+            float(lm_eval["acc_avg"]), expected_average, rel_tol=0, abs_tol=1e-9
+        ),
+        f"{spec.run_id}: lm-eval acc_avg does not match ten tasks",
+    )
+
+    return result, {
+        "result": str(result_path),
+        "result_sha256": hashes.get(result_path),
+        "reference_cache": str(cache_path),
+        "reference_cache_sha256": reference["cache_sha256"],
+        "reference_metadata": metadata,
+        "eval_tokens_identity": eval_tokens_identity,
+        "metrics": metrics,
+    }
+
+
+def audit_campaign(
+    campaign_root: str | Path,
+    *,
+    model_paths: Mapping[str, str | Path] | None = None,
+    evaluator_path: str | Path | None = None,
+    verify_hf_hashes: bool = False,
+    verify_all_hashes: bool = False,
+    expected_token_sha256: str = TOKEN_SHA256,
+    expected_hessian_sha256: Mapping[tuple[str, str], str] | None = None,
+) -> dict[str, Any]:
+    """Audit the formal six-run campaign and return a JSON-serializable summary."""
+
+    root = Path(campaign_root).resolve()
+    _require_directory(root, "campaign_root")
+    workspace = Path(__file__).resolve().parents[2]
+    default_models = {
+        "1b": workspace / "modelzoo/Llama/Llama-3.2-1B",
+        "3b": workspace / "modelzoo/Llama/Llama-3.2-3B",
+    }
+    supplied_models = model_paths or {}
+    models = {
+        size: Path(supplied_models.get(size, default)).resolve()
+        for size, default in default_models.items()
+    }
+    for size, path in models.items():
+        _require_directory(path, f"model_{size}")
+    evaluator = Path(evaluator_path or (workspace / "utils/eval_utils.py")).resolve()
+    _require(
+        evaluator.is_file() and not evaluator.is_symlink(),
+        f"missing evaluator source {evaluator}",
+    )
+    verify_current_hf_hashes = verify_hf_hashes or verify_all_hashes
+    expected_hessian = (
+        HESSIAN_VALIDATION_SHA256
+        if expected_hessian_sha256 is None
+        else expected_hessian_sha256
+    )
+    _require_sha256(expected_token_sha256, "expected_token_sha256")
+    expected_hessian_keys = {
+        (spec.model_size, spec.hessian_mode) for spec in RUN_SPECS
+    }
+    _require(
+        expected_hessian_keys.issubset(expected_hessian),
+        "expected Hessian SHA mapping is incomplete",
+    )
+    for key in expected_hessian_keys:
+        _require_sha256(expected_hessian[key], f"expected_hessian_sha256[{key}]")
+
+    calibration_path = (
+        workspace
+        / "cache/tokens/Llama-3.2-1B_wikitext2_train_n256_sl2048_seed1.pt"
+    ).resolve()
+    if model_paths is not None and "calibration" in model_paths:
+        calibration_path = Path(model_paths["calibration"]).resolve()
+    _require(
+        calibration_path.is_file() and not calibration_path.is_symlink(),
+        f"missing calibration token artifact {calibration_path}",
+    )
+    hashes = _HashCache()
+    _require(
+        hashes.get(calibration_path) == expected_token_sha256,
+        "live calibration token SHA256 mismatch",
+    )
+
+    expected_run_names = {spec.run_id for spec in RUN_SPECS}
+    expected_json_names = {f"{name}.json" for name in expected_run_names}
+    _require_exact_top_level(
+        root / "raw",
+        expected_run_names,
+        directories=True,
+        label="campaign.raw",
+    )
+    _require_exact_top_level(
+        root / "hf",
+        expected_run_names,
+        directories=True,
+        label="campaign.hf",
+    )
+    _require_exact_top_level(
+        root / "validation",
+        expected_json_names,
+        directories=False,
+        label="campaign.validation",
+    )
+    _require_exact_top_level(
+        root / "results",
+        expected_json_names,
+        directories=False,
+        label="campaign.results",
+    )
+
+    run_summaries = []
+    references_by_model: dict[str, tuple[str, str, dict[str, Any]]] = {}
+    total_quant_seconds = 0
+    total_quant_gpu_hours = 0.0
+    hessian_binding_by_mode: dict[tuple[str, str], tuple[str, str]] = {}
+    for spec in RUN_SPECS:
+        model_path = models[spec.model_size]
+        _require(
+            model_path.name == spec.model_name,
+            f"{spec.run_id}: expected model basename {spec.model_name}",
+        )
+        _, artifact = _validate_validation_report(
+            root,
+            spec,
+            model_path,
+            calibration_path,
+            expected_token_sha256,
+            expected_hessian,
+            hashes,
+            verify_hf_hashes=verify_current_hf_hashes,
+            verify_all_hashes=verify_all_hashes,
+        )
+        result_path = root / "results" / f"{spec.run_id}.json"
+        _, evaluation = _validate_result(
+            root,
+            spec,
+            model_path,
+            artifact,
+            evaluator,
+            hashes,
+            verify_all_hashes=verify_all_hashes,
+        )
+        states = _validate_states(root, spec, artifact, result_path)
+
+        binding_key = (spec.model_size, spec.hessian_mode)
+        binding = (
+            artifact["hessian"]["validation_report"],
+            artifact["hessian"]["validation_report_sha256"],
+        )
+        if binding_key in hessian_binding_by_mode:
+            _require(
+                hessian_binding_by_mode[binding_key] == binding,
+                f"{spec.run_id}: same Hessian mode is not shared consistently",
+            )
+        hessian_binding_by_mode[binding_key] = binding
+
+        reference_tuple = (
+            evaluation["reference_cache"],
+            evaluation["reference_cache_sha256"],
+            evaluation["reference_metadata"],
+        )
+        if spec.model_size in references_by_model:
+            _require(
+                references_by_model[spec.model_size] == reference_tuple,
+                f"{spec.run_id}: FP reference differs across settings",
+            )
+        references_by_model[spec.model_size] = reference_tuple
+
+        quant_seconds = states["quantize"]["elapsed_seconds"]
+        quant_gpu_hours = states["quantize"]["gpu_hours"]
+        total_quant_seconds += quant_seconds
+        total_quant_gpu_hours += quant_gpu_hours
+        run_summaries.append(
+            {
+                "run_id": spec.run_id,
+                "model_size": spec.model_size,
+                "model": str(model_path),
+                "setting": spec.setting,
+                "weight_bits": spec.weight_bits,
+                "weight_groupsize": 128,
+                "weight_quantizer": "realq_wclip",
+                "yaqa_rotation": {
+                    "method": "YAQA_default_RHT",
+                    "td_x": 1,
+                    "td_y": 128,
+                    "V": 1,
+                },
+                "aware_semantics": (
+                    "A4/K4/V4-aware Hessian and deployed symmetric per-token QDQ"
+                    if spec.setting == "W2A4KV4"
+                    else "A16/KV16 identity; Hessian aware mode is n/a"
+                ),
+                "artifacts": artifact,
+                "evaluation": evaluation,
+                "states": states,
+            }
+        )
+
+    campaign_states = {}
+    for model_size in ("1b", "3b"):
+        visible_gpus = "0,1,2,3" if model_size == "1b" else "4,5,6,7"
+        for controller in ("lane", "postprocess"):
+            path = root / "state" / f"{controller}_{model_size}.state"
+            campaign_states[f"{controller}_{model_size}"] = _require_completed_state(
+                path,
+                label=f"{controller}_{model_size}",
+                required={
+                    "model_size": model_size,
+                    "visible_gpus": visible_gpus,
+                },
+                require_elapsed=False,
+            )
+
+    eval_identities = {
+        run["evaluation"]["eval_tokens_identity"] for run in run_summaries
+    }
+    _require(
+        len(eval_identities) == 1,
+        "WikiText2 evaluation token identity differs across the six runs",
+    )
+    return {
+        "schema_version": 1,
+        "status": "completed",
+        "campaign_root": str(root),
+        "run_count": len(run_summaries),
+        "protocol": {
+            "models": [str(models["1b"]), str(models["3b"])],
+            "settings": ["W4A16KV16", "W3A16KV16", "W2A4KV4"],
+            "weight_quantizer": "realq_wclip",
+            "weight_groupsize": 128,
+            "calibration_dataset": "wikitext2_train",
+            "calibration_sequences": 256,
+            "calibration_sequence_length": 2048,
+            "calibration_tokens_path": str(calibration_path),
+            "calibration_tokens_sha256": expected_token_sha256,
+            "wikitext2_eval": {
+                "split": "test",
+                "sequence_length": 2048,
+                "kl_direction": "KL(FP||quantized)",
+                "kl_full_vocabulary_fp32": True,
+                "eval_tokens_identity": next(iter(eval_identities)),
+            },
+            "lm_eval": {
+                "version": "0.4.4",
+                "num_fewshot": 0,
+                "apply_chat_template": False,
+                "batch_size": 32,
+                "tasks": list(PAPER_TASKS),
+            },
+        },
+        "integrity": {
+            "validation_reports_bind_raw_and_hf_by_sha256": True,
+            "results_bind_validation_report_sha256": True,
+            "current_raw_config_and_layernorm_hashes_verified": True,
+            "current_full_hf_hashes_verified": verify_current_hf_hashes,
+            "current_full_raw_hashes_verified": verify_all_hashes,
+            "current_reference_cache_hashes_verified": verify_all_hashes,
+            "current_hessian_tensor_hashes_verified": verify_all_hashes,
+        },
+        "campaign_states": campaign_states,
+        "quantization_totals": {
+            "sum_run_wall_seconds": total_quant_seconds,
+            "sum_run_gpu_hours": total_quant_gpu_hours,
+        },
+        "runs": run_summaries,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("campaign_root")
+    parser.add_argument("--model-1b")
+    parser.add_argument("--model-3b")
+    parser.add_argument("--evaluator-path")
+    parser.add_argument(
+        "--verify-hf-hashes",
+        action="store_true",
+        help="re-hash every current HF file against the validation report",
+    )
+    parser.add_argument(
+        "--verify-all-hashes",
+        action="store_true",
+        help=(
+            "re-hash all raw/HF/Hessian tensors and FP reference caches; "
+            "implies --verify-hf-hashes"
+        ),
+    )
+    args = parser.parse_args()
+    model_paths = None
+    if args.model_1b or args.model_3b:
+        workspace = Path(__file__).resolve().parents[2]
+        model_paths = {
+            "1b": args.model_1b
+            or workspace / "modelzoo/Llama/Llama-3.2-1B",
+            "3b": args.model_3b
+            or workspace / "modelzoo/Llama/Llama-3.2-3B",
+        }
+    try:
+        result = audit_campaign(
+            args.campaign_root,
+            model_paths=model_paths,
+            evaluator_path=args.evaluator_path,
+            verify_hf_hashes=args.verify_hf_hashes,
+            verify_all_hashes=args.verify_all_hashes,
+        )
+    except (AuditError, OSError, KeyError) as exc:
+        print(f"YAQA_wclip campaign audit failed: {exc}", file=sys.stderr)
+        raise SystemExit(1) from exc
+    print(json.dumps(result, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
