@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+import pytest
+import torch
+
+from lib.algo.ldlq import LDLQ_2hess
+from lib.codebook.wclip import WClipQuantizer
+from utils.quant_utils import WeightQuantizer
+
+
+def _realq_reference(weight: torch.Tensor, bits: int, groupsize: int):
+    quantizer = WeightQuantizer()
+    quantizer.configure(
+        bits=bits,
+        perchannel=True,
+        sym=True,
+        mse=True,
+        norm=2.4,
+        grid=50,
+        maxshrink=0.5,
+        weight_groupsize=groupsize,
+        w_clip_search_impl="cartesian_legacy",
+        w_clip_update_impl="guarded",
+        w_group_param_layout="compact",
+    )
+    quantizer.find_params(weight)
+    dequantized, codes, _ = quantizer.fake_quantize(weight)
+    return quantizer, dequantized, codes
+
+
+@pytest.mark.parametrize(
+    ("bits", "expected_min", "expected_max"),
+    [(2, -2, 1), (3, -4, 3), (4, -8, 7)],
+)
+def test_signed_integer_ranges(bits, expected_min, expected_max):
+    quantizer = WClipQuantizer(bits=bits, groupsize=128)
+    assert quantizer.minq == expected_min
+    assert quantizer.qmax == expected_max
+
+
+@pytest.mark.parametrize("bits", [2, 3, 4])
+def test_fit_and_qdq_are_exactly_equal_to_realq_with_short_tail(bits):
+    generator = torch.Generator().manual_seed(20260725 + bits)
+    weight = torch.randn(3, 257, generator=generator, dtype=torch.float32)
+    # Make different rows/groups observably use different scales.
+    weight[0, :128] *= 0.1
+    weight[1, 128:256] *= 3.0
+    weight[2, 256] = -7.0
+
+    ours = WClipQuantizer(bits=bits, groupsize=128).fit(weight)
+    reference, reference_dq, reference_codes = _realq_reference(
+        weight, bits, 128
+    )
+
+    assert ours.scales.shape == (3, 3)
+    assert torch.equal(ours.scales, reference.scale)
+
+    rows = torch.arange(weight.shape[0])
+    columns = torch.arange(weight.shape[1])
+    actual_dq, actual_codes = ours.quantize_dequantize(
+        weight, row_indices=rows, column_indices=columns
+    )
+    assert torch.equal(actual_dq, reference_dq)
+    assert torch.equal(actual_codes, reference_codes.to(torch.int8))
+
+
+def test_natural_column_groups_do_not_flatten_across_rows():
+    weight = torch.zeros(2, 9, dtype=torch.float32)
+    weight[0, :4] = torch.tensor([0.1, -0.2, 0.3, -0.4])
+    weight[0, 4:8] = torch.tensor([1.0, -2.0, 3.0, -4.0])
+    weight[0, 8] = 8.0
+    weight[1, :4] = 10 * weight[0, :4]
+    weight[1, 4:8] = 0.01 * weight[0, 4:8]
+    weight[1, 8] = -0.5
+
+    quantizer = WClipQuantizer(bits=4, groupsize=4).fit(weight)
+    assert quantizer.scales.shape == (2, 3)
+    assert quantizer.scales[0, 0] != quantizer.scales[1, 0]
+    assert quantizer.scales[0, 1] != quantizer.scales[1, 1]
+    assert quantizer.scales[0, 2] != quantizer.scales[1, 2]
+
+    expanded = quantizer.expanded_scales()
+    assert torch.equal(expanded[:, 0], expanded[:, 3])
+    assert torch.equal(expanded[:, 4], expanded[:, 7])
+    assert torch.equal(expanded[:, 8], quantizer.scales[:, 2])
+
+
+def test_tile_projection_uses_absolute_row_and_column_coordinates():
+    generator = torch.Generator().manual_seed(9)
+    weight = torch.randn(4, 8, generator=generator, dtype=torch.float32)
+    quantizer = WClipQuantizer(bits=3, groupsize=4).fit(weight)
+    target = torch.randn(1, 2, 4, generator=generator, dtype=torch.float32)
+
+    tile_dq, tile_codes = quantizer.quantize_tiles(
+        target, [(1, 1)], td_x=2, td_y=4
+    )
+    direct_dq, direct_codes = quantizer.quantize_dequantize(
+        target[0],
+        row_indices=torch.tensor([2, 3]),
+        column_indices=torch.tensor([4, 5, 6, 7]),
+    )
+    assert torch.equal(tile_dq[0], direct_dq)
+    assert torch.equal(tile_codes[0], direct_codes)
+
+
+def test_ldlq_keeps_frozen_scales_and_reduces_to_rtn_without_feedback():
+    generator = torch.Generator().manual_seed(123)
+    weight = torch.randn(2, 256, generator=generator, dtype=torch.float32)
+    quantizer = WClipQuantizer(bits=4, groupsize=128).fit(weight)
+    scales_before = quantizer.scales.clone()
+
+    lin = torch.zeros(256, 256, dtype=torch.float32)
+    lout = torch.zeros(2, 2, dtype=torch.float32)
+    hat_weight, codes = LDLQ_2hess(
+        weight,
+        lin,
+        lout,
+        td_x=1,
+        td_y=128,
+        V=1,
+        cb=quantizer,
+        for_kernel=False,
+    )
+
+    expected = quantizer.dequantize_codes(codes)
+    assert torch.equal(hat_weight, expected)
+    assert torch.equal(quantizer.scales, scales_before)
+    assert int(codes.min()) >= quantizer.minq
+    assert int(codes.max()) <= quantizer.qmax
