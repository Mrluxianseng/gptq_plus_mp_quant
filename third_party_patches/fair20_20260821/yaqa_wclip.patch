+"${PYTHON_BIN}" -m pytest -q \
+  YAQA_wclip/tests/test_wclip_quantizer.py \
+  YAQA_wclip/tests/test_wclip_hfize.py \
+  YAQA_wclip/tests/test_wclip_provenance.py
+
+"${PYTHON_BIN}" - <<'PY'
+import torch
+
+from lib.codebook.wclip import WClipQuantizer
+from utils.quant_utils import WeightQuantizer
+
+if not torch.cuda.is_available():
+    print("CUDA unavailable: skipped CUDA bit-exact comparison")
+    raise SystemExit(0)
+
+generator = torch.Generator(device="cuda").manual_seed(7)
+weight = torch.randn(
+    3, 257, device="cuda", dtype=torch.float32, generator=generator
+)
+for bits in (2, 3, 4):
+    actual = WClipQuantizer(bits=bits, groupsize=128).cuda().fit(weight)
+    reference = WeightQuantizer().cuda()
+    reference.configure(
+        bits=bits,
+        perchannel=True,
+        sym=True,
+        mse=True,
+        norm=2.4,
+        grid=50,
+        maxshrink=0.5,
+        weight_groupsize=128,
+        w_clip_search_impl="cartesian_legacy",
+        w_clip_update_impl="guarded",
+        w_group_param_layout="compact",
+    )
+    reference.find_params(weight)
+    reference_dq, reference_codes, _ = reference.fake_quantize(weight)
+    actual_dq, actual_codes = actual.quantize_dequantize(
+        weight,
+        row_indices=torch.arange(3, device="cuda"),
+        column_indices=torch.arange(257, device="cuda"),
+    )
+    assert torch.equal(actual.scales, reference.scale)
+    assert torch.equal(actual_dq, reference_dq)
+    assert torch.equal(actual_codes, reference_codes.to(torch.int8))
+    print(
+        f"CUDA exact: W{bits}, scales={tuple(actual.scales.shape)}, "
+        f"codes=[{int(actual_codes.min())}, {int(actual_codes.max())}]"
+    )
+PY
