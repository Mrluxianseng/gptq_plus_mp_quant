+                    ).sum(dim=-1)
+                denominator = (
+                    H_out[:, row_idx, row_idx]
+                    * code_h_code[:, row_idx]
+                )
+                old_scale = scale[:, row_idx, group_idx, 0]
+                delta_scale = numerator / denominator
+                valid = (
+                    torch.isfinite(numerator)
+                    & torch.isfinite(denominator)
+                    & (denominator > 0)
+                    & torch.isfinite(old_scale + delta_scale)
+                )
+                delta_scale = torch.where(
+                    valid, delta_scale, torch.zeros_like(delta_scale)
+                )
+                scale[:, row_idx, group_idx, 0] = (
+                    old_scale + delta_scale
+                )
+                delta_q = delta_scale.unsqueeze(-1) * code
+                Q_flat[:, row_idx, start:end] += delta_q
+                residual_h[:, row_idx, :] -= (
+                    delta_q.unsqueeze(1) @ h_group_all
+                ).squeeze(1)
+
+    return Q_flat.reshape_as(Q), scale
+
+
 def compute_loss_degradation(W, Q, H_in, H_row, dXXT):
     if len(W.shape) == 4:
         n_heads, head_dim, n_groups, group_size = W.shape
