+def install_post_rope_observers(llm):
+    """Expose Q/K tensors after the deployed RoPE/QK-aware transform.
+
+    TurboBoA's copied Llama attention already contains ``rot_out_Q/K``
+    identities.  Stock Qwen3 must be retained to preserve head-wise
+    q_norm/k_norm, so its forward is patched locally.  This function is
+    deliberately called *after* the shared QKRotationWrapper is installed:
+    the existing ``apply_rotary_pos_emb`` callable is wrapped without
+    unwrapping it, preserving the chain
+
+        RMSNorm -> RoPE -> optional shared QK Hadamard/K-QDQ -> observer.
+    """
+    llm_type = type(llm).__name__
+    blocks = get_transformer_blocks(llm)
+    if llm_type == "LlamaForCausalLM":
+        missing = [
+            index
+            for index, block in enumerate(blocks)
+            if not (
+                hasattr(block.self_attn, "rot_out_Q")
+                and hasattr(block.self_attn, "rot_out_K")
+            )
+        ]
+        if missing:
+            raise RuntimeError(
+                "TurboBoA's custom Llama attention is missing native "
+                f"post-RoPE observers on blocks {missing[:8]}."
+            )
+        return
+    if llm_type != "Qwen3ForCausalLM":
+        raise NotImplementedError(
+            f"Post-RoPE observers are not implemented for {llm_type}."
+        )
