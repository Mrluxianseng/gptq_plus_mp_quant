+def _build_rmsnorm_jacobian_collectors(
+    transformer_block,
+    n_heads,
+    n_kv_heads,
+    head_dim,
+    collector_cls,
+):
+    """Return Q/K pre-norm Jacobian collectors for Qwen3, or identity."""
