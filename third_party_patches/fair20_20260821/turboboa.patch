+"""Adapter for REAL-Q's exact symmetric MSE weight quantizer.
+
+This module intentionally imports the quantizer from the workspace-level
+``utils`` package instead of copying its arithmetic.  The comparison protocol
+requires the two methods to share the *same implementation*, including its
+signed integer range, clipping-grid traversal, tie handling, and natural
+column grouping.
+
+TurboBoA asks a quantizer to observe tensors with extra leading head/row
+dimensions.  :class:`RealQMSEQuantizer` only reshapes those leading dimensions
+to the two-dimensional ``(rows, columns)`` contract of
+``utils.quant_utils.WeightQuantizer`` and reshapes the resulting qparams back.
+No quantization formula is reimplemented here.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from utils.quant_utils import (
+    WeightQuantizer as _SharedWeightQuantizer,
+    sym_quant as _shared_sym_quant,
+    sym_quant_dequant as _shared_sym_quant_dequant,
+)
+
+
+class RealQMSEQuantizer(_SharedWeightQuantizer):
+    """TurboBoA-facing view of REAL-Q's shared ``WeightQuantizer``.
+
+    ``find_params_H*`` deliberately ignores TurboBoA's Hessian/search flags:
+    using a Hessian or TurboBoA's MMSE grid to choose scales would change the
+    quantizer and invalidate the controlled comparison.  TurboBoA still owns
+    all row/column compensation and optional F3 scale refinement after the
+    shared MSE observer has selected its starting grid.
+    """
+
+    mode_name = "realq_mse"
+
+    def configure(
+        self,
+        n_bits: int,
+        per_channel: bool = True,
+        group_size: int = -1,
+        sym: bool = True,
+        mse: bool = True,
+        norm: float = 2.4,
+        grid: int = 50,
+        maxshrink: float = 0.5,
+    ) -> None:
+        if not sym:
+            raise ValueError(
+                "RealQMSEQuantizer is symmetric-only; pass --w_sym."
+            )
+        if not mse:
+            raise ValueError(
+                "RealQMSEQuantizer always enables REAL-Q's MSE/w_clip search."
+            )
+        if norm != 2.4 or grid != 50 or maxshrink != 0.5:
+            raise ValueError(
+                "The controlled REAL-Q comparison fixes norm=2.4, grid=50, "
+                "and maxshrink=0.5."
+            )
+        if group_size != -1 and group_size <= 0:
+            raise ValueError(
+                f"group_size must be -1 or positive; got {group_size}."
+            )
+
+        self.n_bits = int(n_bits)
+        self.group_size = int(group_size)
+        super().configure(
+            bits=self.n_bits,
+            perchannel=bool(per_channel),
+            sym=True,
+            mse=True,
+            norm=norm,
+            grid=grid,
+            maxshrink=maxshrink,
+            weight_groupsize=self.group_size,
+            # Compact storage is an exact representation of the shared
+            # natural-column qparams and matches TurboBoA's one-scale-per-
+            # (output row, weight group) state shape.
+            w_group_param_layout="compact",
+        )
+
+    def _new_shared_observer(self, group_size: int) -> _SharedWeightQuantizer:
+        observer = _SharedWeightQuantizer()
+        observer.configure(
+            bits=self.n_bits,
+            perchannel=True,
+            sym=True,
+            mse=True,
+            norm=self.norm,
+            grid=self.grid,
+            maxshrink=self.maxshrink,
+            weight_groupsize=group_size,
+            w_group_param_layout="compact",
+        )
+        return observer
+
+    def _observe(
+        self,
+        weight: torch.Tensor,
+        *,
+        group_size: int,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if weight.ndim < 2:
+            raise ValueError(
+                "REAL-Q weight observation requires at least two dimensions; "
+                f"got shape={tuple(weight.shape)}."
+            )
+        columns = int(weight.shape[-1])
+        flat = weight.reshape(-1, columns)
+        if group_size > 0 and columns % group_size != 0:
+            raise ValueError(
+                "TurboBoA's grouped solver requires complete weight groups; "
+                f"columns={columns} is not divisible by group_size={group_size}."
+            )
+        observer = self._new_shared_observer(group_size)
+        observer.find_params(flat)
+        return observer.scale, observer.zero
+
+    def find_params_H(
+        self,
+        weight: torch.Tensor,
+        H_in: torch.Tensor | None,
+        search: bool,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Observe one current TurboBoA group with REAL-Q MSE.
+
+        ``H_in`` and ``search`` are accepted only for API compatibility.
+        """
+        del H_in, search
+        leading_shape = weight.shape[:-1]
+        scale, zero = self._observe(weight, group_size=-1)
+        return (
+            scale.reshape(*leading_shape, 1),
+            zero.reshape(*leading_shape, 1),
+        )
+
+    def find_params_H_group(
+        self,
+        weight: torch.Tensor,
+        H_in: torch.Tensor | None,
+        search: bool,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Observe all natural groups while preserving leading row axes."""
+        del H_in, search
+        if weight.ndim < 3:
+            raise ValueError(
+                "Grouped TurboBoA observation expects [..., groups, width]; "
+                f"got shape={tuple(weight.shape)}."
+            )
+        n_groups, group_width = map(int, weight.shape[-2:])
+        if self.group_size == -1:
+            if n_groups != 1:
+                raise ValueError(
+                    "Per-row REAL-Q quantization expects one logical group; "
+                    f"got n_groups={n_groups}."
+                )
+            observer_group_size = -1
+        else:
+            if group_width != self.group_size:
+                raise ValueError(
+                    "TurboBoA group width and configured REAL-Q group size "
+                    f"differ: {group_width} != {self.group_size}."
+                )
+            observer_group_size = self.group_size
+
+        leading_shape = weight.shape[:-2]
+        flat_weight = weight.reshape(-1, n_groups * group_width)
+        scale, zero = self._observe(
+            flat_weight,
+            group_size=observer_group_size,
+        )
+        return (
+            scale.reshape(*leading_shape, n_groups, 1),
+            zero.reshape(*leading_shape, n_groups, 1),
+        )
+
+    def quantize_int(
+        self,
+        x: torch.Tensor,
+        scale: torch.Tensor,
+        zero: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Return REAL-Q's signed integer codes."""
+        del zero
+        q, _ = _shared_sym_quant(x, scale, self.maxq)
+        return q
+
+    @staticmethod
+    def center_int(
+        q: torch.Tensor,
+        zero: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        del zero
+        return q
+
+    def fake_quantize_values(
+        self,
+        x: torch.Tensor,
+        scale: torch.Tensor,
+        zero: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Use the shared signed QDQ primitive without duplicating it."""
+        del zero
+        return _shared_sym_quant_dequant(x, scale, self.maxq)
+
