+from __future__ import annotations
+
+import json
+import hashlib
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from turboBOA import main as entrypoint
+from turboBOA.utils import experiment_utils
+from turboBOA.utils.process_args import get_turboboa_arguments
+from utils import eval_utils as shared_eval_utils
+
+
+def _args(tmp_path, *extra):
+    return get_turboboa_arguments(
+        [
+            "--llm_path",
+            "modelzoo/Llama/Llama-3.2-1B",
+            "--cache_dir",
+            str(tmp_path / "cache"),
+            "--results_path",
+            str(tmp_path / "result.json"),
+            *extra,
+        ]
+    )
+
+
+def test_controlled_cli_defaults_and_fixed_eval_surface(tmp_path):
+    args = _args(tmp_path)
+    assert args.act_quant_aware_gptq is False
+    assert args.k_cache_quant_aware_gptq is False
+    assert args.lm_eval_batch_size == 8
+    assert isinstance(args.lm_eval_batch_size, int)
+    assert args.eval_seq_len == 2048
+    assert args.quant_stop_layer is None
+    assert args.skip_eval is False
+    assert args.require_calibration_cache_hit is False
+    assert args.require_reference_cache_hit is False
+    assert not hasattr(args, "tasks")
+
+    stopped = _args(tmp_path, "--quant_stop_layer", "0", "--skip_eval")
+    assert stopped.quant_stop_layer == 0
+    assert stopped.skip_eval is True
+
+    with pytest.raises(SystemExit):
+        _args(tmp_path, "--tasks", "piqa")
+
+
+def test_prepare_args_fixes_full_vocab_and_exact_paper_tasks(tmp_path):
+    args = _args(tmp_path)
+    experiment_utils.prepare_shared_args(args)
+    assert args.kl_topk == -1
+    assert args.eval_datasets == ["wikitext2"]
+    assert args.tasks == list(shared_eval_utils.PAPER_QA_TASKS)
+    assert len(args.tasks) == 10
+
+
+def test_shared_calibration_uses_model_identity_cache(monkeypatch, tmp_path):
+    args = _args(
+        tmp_path,
+        "--nsamples",
+        "2",
+        "--seqlen",
+        "4",
+    )
+    experiment_utils.prepare_shared_args(args)
+    calls = []
+
+    def fake_get_tokens(
+        dataset,
+        split,
+        tokenizer,
+        seq_len,
+        num_samples,
+        save_path=None,
+        seed=0,
+    ):
+        calls.append(
+            (dataset, split, seq_len, num_samples, save_path, seed)
+        )
+        return [
+            torch.arange(seq_len),
+            torch.arange(seq_len) + 10,
+        ]
+
+    monkeypatch.setattr(
+        experiment_utils.shared_data_utils,
+        "get_tokens",
+        fake_get_tokens,
+    )
+    calibration = experiment_utils.load_shared_calibration(
+        args, SimpleNamespace(tokenizer=object())
+    )
+    assert len(calibration) == 2
+    assert calibration[0][0].shape == (1, 4)
+    assert calls[0][:4] == ("wikitext2", "train", 4, 2)
+    assert args.model_identity[:16] in calls[0][4]
+    assert calls[0][5] == args.seed
+
+
+def test_required_calibration_cache_hit_refuses_regeneration(
+    monkeypatch, tmp_path
+):
+    args = _args(
+        tmp_path,
+        "--nsamples",
+        "2",
+        "--seqlen",
+        "4",
+        "--require_calibration_cache_hit",
+    )
+    experiment_utils.prepare_shared_args(args)
+    monkeypatch.setattr(
+        experiment_utils.shared_data_utils,
+        "get_tokens",
+        lambda *_args, **_kwargs: pytest.fail(
+            "cache-miss path must fail before token regeneration"
+        ),
+    )
+    with pytest.raises(
+        RuntimeError, match="Required calibration-token cache hit"
+    ):
+        experiment_utils.load_shared_calibration(
+            args, SimpleNamespace(tokenizer=object())
+        )
+
+
+def test_explicit_calibration_is_loaded_by_path_and_sha(monkeypatch, tmp_path):
+    artifact = tmp_path / "tokens.pt"
+    torch.save(
+        [torch.arange(4, dtype=torch.int64), torch.arange(4, dtype=torch.int64)],
+        artifact,
+    )
+    digest = hashlib.sha256(artifact.read_bytes()).hexdigest()
+    args = _args(
+        tmp_path,
+        "--nsamples",
+        "2",
+        "--seqlen",
+        "4",
+        "--calib_tokens_file",
+        str(artifact),
+        "--calib_tokens_sha256",
+        digest,
+    )
+    experiment_utils.prepare_shared_args(args)
+    monkeypatch.setattr(
+        experiment_utils.shared_data_utils,
+        "get_tokens",
+        lambda *_args, **_kwargs: pytest.fail("must not resample explicit tokens"),
+    )
+    calibration = experiment_utils.load_shared_calibration(
+        args, SimpleNamespace(tokenizer=object())
+    )
+    assert len(calibration) == 2
+    assert calibration[0][0].shape == (1, 4)
+    assert args.calib_tokens_file == str(artifact.resolve())
+    assert args.calib_tokens_sha256 == digest
+
+
+def test_entrypoint_orders_reference_before_transform_and_eval_last(
+    monkeypatch, tmp_path
+):
+    args = _args(tmp_path)
+    events = []
+
+    class LlamaForCausalLM:
+        def eval(self):
+            events.append("model_eval")
+            return self
+
+    model = LlamaForCausalLM()
+    analyzer = SimpleNamespace(model=model, tokenizer=object())
+    reference = object()
+    calibration = [object()]
+
+    def prepare(local_args):
+        events.append("prepare_args")
+        local_args.model_identity = "identity"
+        local_args.model_name = "model"
+        local_args.model = local_args.llm_path
+        local_args.eval_datasets = ["wikitext2"]
+        local_args.kl_topk = -1
+        local_args.tasks = list(shared_eval_utils.PAPER_QA_TASKS)
+
+    monkeypatch.setattr(entrypoint, "prepare_shared_args", prepare)
+    monkeypatch.setattr(
+        entrypoint,
+        "get_model",
+        lambda _path: events.append("load_model") or model,
+    )
+    monkeypatch.setattr(
+        entrypoint.shared_model_utils,
+        "ModelAnalyzer",
+        lambda *_args, **_kwargs: events.append("analyzer") or analyzer,
+    )
+    monkeypatch.setattr(
+        entrypoint,
+        "load_shared_calibration",
+        lambda *_args: events.append("calibration") or calibration,
+    )
+    monkeypatch.setattr(
+        entrypoint,
+        "capture_fp_reference",
+        lambda *_args: events.append("fp_reference") or reference,
+    )
+    monkeypatch.setattr(
+        entrypoint.shared_rotation_utils,
+        "prepare_model_for_rotated_quantization",
+        lambda *_args: events.append("rotate"),
+    )
+    monkeypatch.setattr(
+        entrypoint.akv,
+        "setup_aware_pre_quant",
+        lambda *_args: events.append("aware"),
+    )
+    monkeypatch.setattr(
+        entrypoint,
+        "install_post_rope_observers",
+        lambda *_args: events.append("post_rope_observers"),
+    )
+    monkeypatch.setattr(
+        entrypoint,
+        "turboboa_fwrd",
+        lambda _model, calib, *_args: (
+            pytest.fail("wrong calibration")
+            if calib is not calibration
+            else events.append("quantize")
+        ),
+    )
+    monkeypatch.setattr(
+        entrypoint.akv,
+        "setup_unaware_post_quant",
+        lambda *_args: events.append("post_quant"),
+    )
+    def evaluate(_args, _analyzer, ref):
+        if ref is not reference:
+            pytest.fail("wrong reference")
+        events.append("evaluate")
+        return {"wikitext2": {"kl_raw": 0.1, "ppl": 2.0}}
+
+    monkeypatch.setattr(entrypoint, "evaluate_shared", evaluate)
+    monkeypatch.setattr(
+        entrypoint,
+        "build_result_payload",
+        lambda *_args, **_kwargs: {"ok": True, "runtime_seconds": {}},
+    )
+    monkeypatch.setattr(
+        entrypoint,
+        "atomic_write_json",
+        lambda *_args: events.append("json"),
+    )
+
+    result = entrypoint.run(args)
+    assert result["ok"] is True
+    assert result["runtime_seconds"]["post_quant_wrapper_setup"] >= 0.0
+    assert events.index("calibration") < events.index("fp_reference")
+    assert events.index("fp_reference") < events.index("rotate")
+    assert events.index("rotate") < events.index("aware")
+    assert events.index("aware") < events.index("quantize")
+    assert events.index("quantize") < events.index("post_quant")
+    assert events.index("post_quant") < events.index("evaluate")
+    assert events.index("evaluate") < events.index("json")
+
+
+def test_fixed_qa_failure_is_not_swallowed(monkeypatch):
+    args = SimpleNamespace(
+        kl_topk=-1,
+        lm_eval=True,
+        lm_eval_batch_size=8,
+    )
+
+    class Model:
+        def cpu(self):
+            return self
+
+    analyzer = SimpleNamespace(model=Model(), tokenizer=object())
+    reference = SimpleNamespace(
