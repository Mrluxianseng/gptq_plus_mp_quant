index 0000000..6e3798c
--- /dev/null
+++ b/tests/test_grouped_refine.py
@@ -0,0 +1,258 @@
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from turboBOA.utils.quant_utils import (
+    compute_loss_degradation,
+    refine_grouped_qparams,
+)
+
+
+def _spd(size, generator):
+    matrix = torch.randn(size, size, generator=generator)
+    return matrix @ matrix.T + 0.5 * torch.eye(size)
+
+
+@pytest.mark.parametrize("attention_aware", [False, True])
+@pytest.mark.parametrize("with_residual", [False, True])
+def test_grouped_coordinate_refine_never_increases_objective(
+    attention_aware, with_residual
+):
+    generator = torch.Generator().manual_seed(20260725)
+    n_heads = 2 if attention_aware else 1
+    n_rows, n_groups, group_width = 3, 3, 2
+    hidden = n_groups * group_width
+    weight = torch.randn(
+        n_heads, n_rows, n_groups, group_width, generator=generator
+    )
+    codes = torch.randint(
+        -3,
+        4,
+        (n_heads, n_rows, n_groups, group_width),
+        generator=generator,
+    ).float()
+    codes[..., 0] += 1
+    scale = (
+        0.1
+        + torch.rand(
+            n_heads, n_rows, n_groups, 1, generator=generator
+        )
+    )
+    quantized = scale * codes
+    h_in = torch.stack([_spd(hidden, generator) for _ in range(n_heads)])
+    h_out = (
+        torch.stack([_spd(n_rows, generator) for _ in range(n_heads)])
+        if attention_aware
+        else None
+    )
+    d_xxt = (
+        0.01
+        * torch.randn(
+            n_heads, hidden, hidden, generator=generator
+        )
+        if with_residual
+        else None
+    )
+
+    before = compute_loss_degradation(
+        weight, quantized, h_in, h_out, d_xxt
+    )
+    refined_q, refined_scale = refine_grouped_qparams(
+        weight,
+        quantized.clone(),
+        h_in,
+        h_out,
+        d_xxt,
+        scale.clone(),
+        codes,
+        n_iters=2,
+    )
+    after = compute_loss_degradation(
+        weight, refined_q, h_in, h_out, d_xxt
+    )
+
+    assert torch.isfinite(refined_q).all()
+    assert torch.isfinite(refined_scale).all()
+    assert after <= before + 2e-5 * before.abs().clamp_min(1)
+    assert torch.allclose(
+        refined_q,
+        refined_scale * codes,
+        atol=1e-6,
+        rtol=1e-6,
+    )
+
+
+def test_zero_code_coordinate_is_left_finite_and_unchanged():
+    weight = torch.randn(1, 2, 2, 2)
+    codes = torch.zeros_like(weight)
+    scale = torch.ones(1, 2, 2, 1)
+    quantized = scale * codes
+    h_in = torch.eye(4).unsqueeze(0)
+    refined_q, refined_scale = refine_grouped_qparams(
+        weight,
+        quantized.clone(),
+        h_in,
+        None,
+        None,
+        scale.clone(),
+        codes,
+    )
+    assert torch.equal(refined_q, quantized)
+    assert torch.equal(refined_scale, scale)
+
+
+def test_noncontiguous_quantized_input_is_returned_with_updates():
+    generator = torch.Generator().manual_seed(7)
+    weight = torch.randn(1, 2, 2, 2, generator=generator)
+    codes_storage = torch.randint(
+        -2, 3, (1, 2, 2, 4), generator=generator
+    ).float()
+    codes = codes_storage[..., ::2]
+    scale = torch.full((1, 2, 2, 1), 0.25)
+    q_storage = torch.zeros(1, 2, 2, 4)
+    q_storage[..., ::2] = scale * codes
+    quantized = q_storage[..., ::2]
+    assert not quantized.is_contiguous()
+    h_in = _spd(4, generator).unsqueeze(0)
+    refined_q, refined_scale = refine_grouped_qparams(
+        weight,
+        quantized,
+        h_in,
+        None,
+        None,
+        scale,
+        codes,
+    )
+    assert torch.allclose(
+        refined_q, refined_scale * codes, atol=1e-6, rtol=1e-6
+    )
+
+
+def test_attention_refine_is_invariant_to_hout_objective_scale():
+    generator = torch.Generator().manual_seed(41)
+    weight = torch.randn(1, 3, 2, 2, generator=generator)
+    codes = torch.randint(
+        -3, 4, weight.shape, generator=generator
+    ).float()
+    codes[..., 0] += 1
+    scale = 0.2 + torch.rand(1, 3, 2, 1, generator=generator)
+    quantized = scale * codes
+    h_in = _spd(4, generator).unsqueeze(0)
+    h_out = _spd(3, generator).unsqueeze(0)
+
+    _, ordinary_scale = refine_grouped_qparams(
+        weight,
+        quantized.clone(),
+        h_in,
+        h_out,
+        None,
+        scale.clone(),
+        codes,
+    )
+    _, tiny_objective_scale = refine_grouped_qparams(
+        weight,
+        quantized.clone(),
+        h_in,
+        h_out * 1e-10,
+        None,
+        scale.clone(),
+        codes,
+    )
+    assert torch.allclose(
+        tiny_objective_scale,
+        ordinary_scale,
+        atol=2e-5,
+        rtol=2e-5,
+    )
+
+
+def test_residual_term_uses_positive_realq_gptaq_sign():
+    # L(s) = (s-1)^2 - 2*.25*(s-1), whose exact minimizer is 1.25.
+    weight = torch.ones(1, 1, 1, 1)
+    codes = torch.ones_like(weight)
+    scale = torch.zeros(1, 1, 1, 1)
+    quantized = scale * codes
+    _, refined_scale = refine_grouped_qparams(
+        weight,
+        quantized,
+        torch.ones(1, 1, 1),
+        None,
+        torch.full((1, 1, 1), 0.25),
+        scale,
+        codes,
+    )
+    assert refined_scale.item() == pytest.approx(1.25)
+
+
+def test_attention_serial_coordinates_match_bruteforce_quadratics():
+    generator = torch.Generator().manual_seed(91)
+    dtype = torch.float64
+    n_rows, n_groups, width = 3, 2, 2
+    hidden = n_groups * width
+    weight = torch.randn(
+        1, n_rows, n_groups, width, generator=generator, dtype=dtype
+    )
+    codes = torch.randint(
+        -2,
+        3,
+        weight.shape,
+        generator=generator,
+    ).to(dtype)
+    codes[codes == 0] = 1
+    scale = (
+        0.2
+        + torch.rand(
+            1, n_rows, n_groups, 1, generator=generator, dtype=dtype
+        )
+    )
+    quantized = scale * codes
+    h_in = _spd(hidden, generator).to(dtype).unsqueeze(0)
+    h_out = _spd(n_rows, generator).to(dtype).unsqueeze(0)
+    # Deliberately non-symmetric: this catches D[:, support] vs D[support, :].
+    d_xxt = (
+        0.05
+        * torch.randn(
+            1, hidden, hidden, generator=generator, dtype=dtype
+        )
+    )
+
+    expected_q = quantized.clone()
+    expected_scale = scale.clone()
+    for group_idx in range(n_groups):
+        start = group_idx * width
+        end = start + width
+        for row_idx in range(n_rows):
+            old_scale = expected_scale[0, row_idx, group_idx, 0]
+
+            def objective_at(candidate):
+                candidate_q = expected_q.clone()
+                candidate_q[0, row_idx, group_idx] = (
+                    candidate * codes[0, row_idx, group_idx]
+                )
+                return compute_loss_degradation(
+                    weight, candidate_q, h_in, h_out, d_xxt
+                )
+
+            center = objective_at(old_scale)
+            minus = objective_at(old_scale - 1)
+            plus = objective_at(old_scale + 1)
+            quadratic = (plus + minus - 2 * center) / 2
+            linear = (plus - minus) / 2
+            optimum = old_scale - linear / (2 * quadratic)
+            expected_scale[0, row_idx, group_idx, 0] = optimum
+            expected_q[0, row_idx, group_idx] = (
+                optimum * codes[0, row_idx, group_idx]
+            )
+
+    actual_q, actual_scale = refine_grouped_qparams(
+        weight,
+        quantized.clone(),
+        h_in,
+        h_out,
+        d_xxt,
+        scale.clone(),
+        codes,
+        n_iters=1,
+    )
+    assert torch.allclose(actual_scale, expected_scale, atol=1e-10, rtol=1e-10)
+    assert torch.allclose(actual_q, expected_q, atol=1e-10, rtol=1e-10)
