+"""Controlled REAL-Q-compatible data, evaluation, and result helpers.
+
+The TurboBoA solver remains independent.  This module owns only the shared
+experiment protocol: exact calibration tokens, the pre-transform FP
+reference, paper evaluation, and durable machine-readable output.
+"""
+from __future__ import annotations
+
+import importlib.metadata
+import hashlib
+import json
+import os
+import random
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import numpy as np
+import torch
+
+from utils import data_utils as shared_data_utils
+from utils import dist_utils as shared_dist_utils
+from utils import eval_utils as shared_eval_utils
+from utils.cache_identity import artifact_cache_tag, artifact_identity
+
+
+def prepare_shared_args(args) -> None:
+    """Populate the names consumed by REAL-Q's shared helpers."""
+    args.model = args.llm_path
+    args.model_name = Path(args.llm_path.rstrip("/")).name or "model"
+    args.eval_datasets = ["wikitext2"]
+    # The controlled evaluator is deliberately full vocabulary.
+    args.kl_topk = -1
+    args.tasks = list(shared_eval_utils.PAPER_QA_TASKS)
+    args.model_identity = artifact_identity(args.llm_path)
+
+    if getattr(args, "deterministic", False):
+        seed = int(args.global_seed)
+        expected_hash_seed = str(seed)
+        if os.environ.get("PYTHONHASHSEED") != expected_hash_seed:
+            raise RuntimeError(
+                "Formal deterministic TurboBoA requires PYTHONHASHSEED="
+                f"{expected_hash_seed} before process startup."
+            )
+        workspace_config = ":4096:8"
+        current_workspace_config = os.environ.get("CUBLAS_WORKSPACE_CONFIG")
+        if current_workspace_config not in (None, workspace_config):
+            raise RuntimeError(
+                "CUBLAS_WORKSPACE_CONFIG conflicts with the formal contract: "
+                f"{current_workspace_config!r}"
+            )
+        os.environ["CUBLAS_WORKSPACE_CONFIG"] = workspace_config
+        random.seed(seed)
+        np.random.seed(seed)
+        torch.manual_seed(seed)
+        if torch.cuda.is_available():
+            torch.cuda.manual_seed_all(seed)
+        torch.use_deterministic_algorithms(True)
+        torch.backends.cudnn.benchmark = False
+        torch.backends.cudnn.deterministic = True
+        torch.backends.cuda.matmul.allow_tf32 = False
+        torch.backends.cudnn.allow_tf32 = False
+        args.determinism_contract = {
+            "enabled": True,
+            "global_seed": seed,
+            "python_hash_seed": seed,
+            "python_random_seed": seed,
+            "numpy_random_seed": seed,
+            "cublas_workspace_config": workspace_config,
+            "torch_deterministic_algorithms": True,
+            "cudnn_benchmark": False,
+            "cudnn_deterministic": True,
+            "allow_tf32": False,
+        }
+    else:
+        args.determinism_contract = {"enabled": False}
+
+    if args.results_path is None:
+        identity_tag = args.model_identity[:12]
+        filename = (
+            f"{args.model_name}-{identity_tag}"
+            f"-w{args.w_bits}a{args.a_bits}k{args.k_bits}v{args.v_bits}"
+            f"-g{args.group_size}-seed{args.seed}.json"
+        )
+        args.results_path = str(
+            Path("output") / "turboboa" / filename
+        )
+
+
+def _sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _load_explicit_calibration(args) -> list[torch.Tensor] | None:
+    configured = getattr(args, "calib_tokens_file", None)
+    if configured is None:
+        return None
+    token_path = Path(configured).resolve()
+    if not token_path.is_file():
+        raise RuntimeError(
+            f"Explicit calibration-token artifact is missing: {token_path}"
+        )
+    expected_sha = str(args.calib_tokens_sha256).lower()
+    actual_sha = _sha256_file(token_path)
+    if actual_sha != expected_sha:
+        raise RuntimeError(
+            "Explicit calibration-token SHA-256 mismatch: "
+            f"{actual_sha} != {expected_sha}"
+        )
+    try:
+        tokens = torch.load(token_path, map_location="cpu", weights_only=True)
+    except TypeError:
+        tokens = torch.load(token_path, map_location="cpu")
+    if type(tokens) is not list or len(tokens) != int(args.nsamples):
+        raise RuntimeError(
+            "Explicit calibration artifact must be a list with exactly "
+            f"{args.nsamples} samples."
+        )
+    for index, token in enumerate(tokens):
+        if (
+            not isinstance(token, torch.Tensor)
+            or token.dtype != torch.int64
+            or token.device.type != "cpu"
+            or token.ndim != 1
+            or tuple(token.shape) != (int(args.seqlen),)
+        ):
+            raise RuntimeError(
+                "Invalid explicit calibration sample at index "
+                f"{index}: type={type(token).__qualname__}, "
+                f"dtype={getattr(token, 'dtype', None)}, "
+                f"shape={getattr(token, 'shape', None)}, "
+                f"device={getattr(token, 'device', None)}"
+            )
+    args.calib_tokens_file = str(token_path)
+    args.calib_tokens_sha256 = actual_sha
+    return tokens
+
+
+def load_shared_calibration(args, analyzer):
+    """Load the same model-identified WikiText-2 tokens as REAL-Q."""
+    if args.calib_data != "wikitext2":
+        raise ValueError(
+            "The controlled TurboBoA comparison fixes calibration to "
+            f"wikitext2; got {args.calib_data!r}."
+        )
+    tokens = _load_explicit_calibration(args)
+    if tokens is None:
+        identity_tag = artifact_cache_tag(args.llm_path, length=16)
+        token_path = (
+            Path(args.cache_dir)
+            / "tokens"
+            / (
+                f"{args.model_name}_{identity_tag}_wikitext2_train"
+                f"_n{args.nsamples}_sl{args.seqlen}_seed{args.seed}.pt"
+            )
+        )
+        if (
+            getattr(args, "require_calibration_cache_hit", False)
+            and not token_path.is_file()
+        ):
+            raise RuntimeError(
+                "Required calibration-token cache hit was unavailable: "
+                f"{token_path}. Run the dedicated artifact producer successfully "
+                "before formal TurboBoA consumers."
+            )
+        tokens = shared_data_utils.get_tokens(
+            "wikitext2",
+            "train",
+            analyzer.tokenizer,
+            args.seqlen,
+            args.nsamples,
+            save_path=str(token_path),
+            seed=args.seed,
+        )
+    calibration = []
+    for index, token in enumerate(tokens):
+        if token.ndim != 1 or token.numel() != args.seqlen:
+            raise RuntimeError(
+                "REAL-Q calibration cache returned an invalid token sample "
+                f"at index {index}: shape={tuple(token.shape)}, "
+                f"expected=({args.seqlen},)."
+            )
+        calibration.append((token.unsqueeze(0),))
+    if len(calibration) != args.nsamples:
+        raise RuntimeError(
+            "REAL-Q calibration cache returned the wrong sample count: "
+            f"{len(calibration)} != {args.nsamples}."
+        )
+    return calibration
+
