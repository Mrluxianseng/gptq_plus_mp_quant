+    if H_in.ndim != 3 or H_in.shape[-2:] != (hidden_size, hidden_size):
+        raise ValueError(
+            "H_in must be [heads|1, hidden, hidden]; got "
+            f"{tuple(H_in.shape)} for hidden={hidden_size}."
