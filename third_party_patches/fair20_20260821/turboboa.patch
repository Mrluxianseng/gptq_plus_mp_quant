+    if W.ndim != 4 or Q.shape != W.shape or centered_codes.shape != W.shape:
+        raise ValueError(
+            "Grouped F3 expects W, Q, and centered_codes with the same "
+            f"4-D shape; got {W.shape}, {Q.shape}, {centered_codes.shape}."
+        )
