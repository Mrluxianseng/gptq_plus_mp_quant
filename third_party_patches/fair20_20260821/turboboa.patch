+def _register_attention_weight_capture(transformer_block, handles):
+    """Capture attention weights without relying on decoder return layout.
+
+    TurboBoA's copied Llama decoder optionally appends attention weights to
+    its return tuple.  Stock Qwen3 deliberately discards them and returns only
+    hidden states, even though ``self_attn`` itself still returns
+    ``(output, weights)``.  A direct hook keeps block-V mathematics identical
+    across both architectures.
+    """
+    captured = []
+
+    def capture(_module, _inputs, output):
+        if (
+            not isinstance(output, tuple)
+            or len(output) < 2
+            or not isinstance(output[1], torch.Tensor)
+            or output[1].ndim != 4
+        ):
+            raise RuntimeError(
+                "TurboBoA block-V requires self_attn to return a rank-4 "
+                "attention-weight tensor in eager mode."
+            )
+        captured.append(output[1])
+
+    handles.append(
+        transformer_block.self_attn.register_forward_hook(capture)
+    )
+    return captured
+
+
+def _take_attention_weights(captured):
+    if len(captured) != 1:
+        raise RuntimeError(
+            "Expected exactly one captured attention matrix for the current "
+            f"decoder forward, got {len(captured)}."
+        )
+    return captured.pop()
+
+
+def _assign_query_key_hout(
+    wrappers,
+    cov_collectors,
+    rmsnorm_collectors,
+    n_heads,
+    n_kv_heads,
+    head_dim,
+    rotary_matrix,
+):
+    """Assign projection-space Q/K output factors.
+
+    The original TurboBoA RoPE/GQA factor is preserved.  When q_norm/k_norm
+    exist, its projection-space pullback is extended with the per-head mean
+    RMSNorm Jacobian: ``H_pre = E[J]^T H_post E[J]``.
+    """
+    query_cov_key = (
+        "rot_out_Q" if rotary_matrix is not None
+        else QKV_NAMES["query"]
+    )
+    key_cov_key = (
+        "rot_out_K" if rotary_matrix is not None
+        else QKV_NAMES["key"]
+    )
+    query_cov = cov_collectors[query_cov_key].YYT
+    key_cov = cov_collectors[key_cov_key].YYT
+
+    if n_kv_heads != n_heads:
+        n_shared = n_heads // n_kv_heads
+        query_cov = query_cov.reshape(
+            n_kv_heads, n_shared, head_dim, head_dim
+        ).mean(dim=1)
+        key_cov = (
+            key_cov[:, None, :, :]
+            .expand(-1, n_shared, -1, -1)
+            .reshape(n_heads, head_dim, head_dim)
+        )
+
+    if rotary_matrix is None:
+        query_hout = key_cov
+        key_hout = query_cov
+    else:
+        rotary_matrix = rotary_matrix.to(key_cov.device)
+        query_hout = (
+            rotary_matrix.transpose(-1, -2)
+            @ key_cov
+            @ rotary_matrix
+        ).mean(0)
+        key_hout = (
+            rotary_matrix.transpose(-1, -2)
+            @ query_cov
+            @ rotary_matrix
+        ).mean(0)
+
+    if rmsnorm_collectors:
+        query_jacobian = rmsnorm_collectors[
