+def capture_fp_reference(args, analyzer):
+    """Capture the unmodified model reference before QuaRot or fake quant."""
+    test_loader = shared_data_utils.get_loaders(
+        "wikitext2",
+        "test",
+        analyzer.tokenizer,
+        args.eval_seq_len,
+        args.nsamples,
+        args.seed,
+    )
+    ref_hidden, orig_lm_head = shared_eval_utils.get_ref_logits(
+        args,
+        analyzer,
+        "wikitext2",
+        test_loader,
+    )
+    return SimpleNamespace(
+        test_loader=test_loader,
+        ref_hidden=ref_hidden,
+        orig_lm_head=orig_lm_head,
+    )
