+def build_weight_quantizer(qconfigs, weight):
+    """Build either the controlled REAL-Q adapter or untouched upstream mode."""
+    mode = qconfigs["weight_quantizer"]
+    group_size = qconfigs["group_size"]
+    if group_size > 0 and weight.shape[-1] % group_size != 0:
+        raise ValueError(
+            "TurboBoA requires complete natural weight groups: "
+            f"in_features={weight.shape[-1]} is not divisible by "
+            f"group_size={group_size}."
+        )
+    if mode == "realq_mse":
+        quantizer = RealQMSEQuantizer()
+        quantizer.configure(
+            qconfigs["w_bits"],
+            per_channel=True,
+            group_size=group_size,
+            sym=qconfigs["w_sym"],
+            mse=True,
+        )
+        # REAL-Q observes cloned FP32 weights. Keeping this boundary identical
+        # is required for byte-exact initial qparams.
+        quantizer.find_params(weight.detach().clone().float())
+        return quantizer
+    if mode == "turboboa":
+        quantizer = MinMaxQuantizer()
+        quantizer.configure(
+            qconfigs["w_bits"],
+            per_channel=True,
+            group_size=group_size,
+            sym=qconfigs["w_sym"],
+            mse=False,
+        )
+        quantizer.find_params(weight)
+        return quantizer
+    raise ValueError(f"Unknown weight quantizer mode: {mode!r}.")
+
