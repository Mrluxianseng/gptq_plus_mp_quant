+++ b/tests/test_quarot_aware.py
@@ -0,0 +1,55 @@
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from turboBOA.quantize import get_rotary_matrix
+from turboBOA.utils.utils import find_layers
+from utils import hadamard_utils
+from utils.quant_utils import ActQuantWrapper
+
+
+class _DummyRotary(torch.nn.Module):
+    def forward(self, _x, position_ids):
+        seq_len = position_ids.shape[-1]
+        angles = torch.linspace(0.1, 0.4, seq_len)
+        cos = torch.cos(angles)[:, None].expand(seq_len, 4).unsqueeze(0)
+        sin = torch.sin(angles)[:, None].expand(seq_len, 4).unsqueeze(0)
+        return cos, sin
+
+
+def test_k_aware_output_transform_is_hadamard_after_rope():
+    config = type(
+        "Config",
+        (),
+        {"head_dim": 4, "hidden_size": 8, "num_attention_heads": 2},
+    )()
+    position_ids = torch.tensor([[0, 1, 2]])
+    rope = get_rotary_matrix(
+        _DummyRotary(), config, position_ids, qk_hadamard=False
+    )
+    transformed = get_rotary_matrix(
+        _DummyRotary(), config, position_ids, qk_hadamard=True
+    )
+    hadamard = hadamard_utils.hadamard_matrix(4, "cpu")
+    expected = hadamard.view(1, 1, 4, 4) @ rope
+    assert torch.allclose(transformed, expected, atol=0, rtol=0)
+
+    # T is orthogonal, so pulling cov(Tx) back with T^T ... T restores
+    # cov(x). This catches both omitted-H and wrong multiplication order.
+    samples = torch.randn(1, 4, 23)
+    for transform in transformed[:, 0]:
+        observed = transform @ samples[0]
+        observed_cov = observed @ observed.T
+        pullback = transform.T @ observed_cov @ transform
+        reference = samples[0] @ samples[0].T
+        assert torch.allclose(pullback, reference, atol=2e-5, rtol=2e-5)
+
+
+def test_find_layers_preserves_wrapper_canonical_name_and_inner_hook_site():
+    inner = torch.nn.Linear(4, 3, bias=False)
+    block = torch.nn.Module()
+    block.self_attn = torch.nn.Module()
+    block.self_attn.q_proj = ActQuantWrapper(inner)
+    layers = find_layers(block)
+    assert set(layers) == {"self_attn.q_proj"}
+    assert layers["self_attn.q_proj"] is inner
