+class MeanRMSNormJacobianCollector:
+    """Collect a per-head mean Jacobian for head-wise RMSNorm.
+
+    For ``y = gamma * x / sqrt(mean(x**2) + eps)``, the per-token
+    Jacobian is
+
+        J(x) = diag(gamma) @ (
+            inv_r * I - inv_r**3 / d * x @ x.T
+        ).
+
+    Qwen3 applies this normalization between q/k projection and RoPE.  A
+    token-dependent Jacobian no longer admits TurboBoA's original single
+    Kronecker factor.  The controlled Qwen3 extension therefore accumulates
+    ``E[J(x)]`` per head and uses it in the local Gauss--Newton/KFAC pullback.
+    This collector intentionally observes only the quantized calibration
+    stream; ``cache_fp=True`` suppresses the F2 teacher pass.
+    """
+
+    def __init__(self, norm, n_heads, head_dim):
+        self.norm = norm
+        self.n_heads = int(n_heads)
+        self.head_dim = int(head_dim)
+        self.cache_fp = True
+        self.sum_inv_r = None
+        self.sum_inv_r3_xxt = None
+        self.n_data = 0
+
+        eps = getattr(norm, "variance_epsilon", getattr(norm, "eps", None))
+        if eps is None:
+            raise TypeError(
+                f"{type(norm).__name__} does not expose RMSNorm epsilon."
+            )
+        self.eps = float(eps)
+
+    def compute_batch(self, _, inp, out):
+        if self.cache_fp:
+            return
+        values = out.detach()
+        expected = self.n_heads * self.head_dim
+        if values.shape[-1] != expected:
+            raise RuntimeError(
+                "RMSNorm Jacobian collector observed an incompatible "
+                f"projection width {values.shape[-1]}; expected {expected} "
+                f"({self.n_heads} heads x {self.head_dim})."
+            )
+
+        # q_proj/k_proj return [B, L, H*d].  Treat every token as one
+        # observation while retaining the head axis.
+        values = values.reshape(-1, self.n_heads, self.head_dim)
+        values = values.transpose(0, 1).float()  # [H, N, d]
+        inv_r = torch.rsqrt(
+            values.square().mean(dim=-1) + self.eps
+        )  # [H, N]
+        batch_sum_inv_r = inv_r.sum(dim=-1)
+        scaled = values * inv_r.pow(1.5).unsqueeze(-1)
+        batch_sum_inv_r3_xxt = (
+            scaled.transpose(-1, -2) @ scaled
+        )
+
+        if self.sum_inv_r is None:
+            self.sum_inv_r = batch_sum_inv_r
+            self.sum_inv_r3_xxt = batch_sum_inv_r3_xxt
+        else:
+            self.sum_inv_r.add_(batch_sum_inv_r)
+            self.sum_inv_r3_xxt.add_(batch_sum_inv_r3_xxt)
+        self.n_data += values.shape[1]
+
+    def mean_jacobian(self):
+        if self.n_data <= 0:
+            raise RuntimeError(
+                "RMSNorm Jacobian collector has no quantized-stream samples."
+            )
+        mean_inv_r = self.sum_inv_r / self.n_data
+        mean_inv_r3_xxt = self.sum_inv_r3_xxt / self.n_data
+        eye = torch.eye(
+            self.head_dim,
+            device=mean_inv_r3_xxt.device,
+            dtype=mean_inv_r3_xxt.dtype,
+        ).expand(self.n_heads, -1, -1)
+        base = (
+            mean_inv_r[:, None, None] * eye
+            - mean_inv_r3_xxt / self.head_dim
+        )
+
+        gamma = self.norm.weight.detach().float().to(base.device)
+        if gamma.numel() == self.head_dim:
+            gamma = gamma.reshape(1, self.head_dim).expand(
+                self.n_heads, -1
+            )
+        elif gamma.numel() == self.n_heads * self.head_dim:
+            gamma = gamma.reshape(self.n_heads, self.head_dim)
+        else:
+            raise RuntimeError(
+                "RMSNorm weight has an incompatible shape "
+                f"{tuple(gamma.shape)} for {self.n_heads} heads x "
+                f"{self.head_dim}."
+            )
+        # diag(gamma) multiplies rows of the unscaled RMS Jacobian.
+        return gamma[:, :, None] * base
+
