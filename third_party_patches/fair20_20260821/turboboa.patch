+def evaluate_shared(args, analyzer, reference) -> dict[str, Any]:
+    """Run full-vocabulary WikiText-2 KL/PPL, then optional paper QA."""
+    if int(args.kl_topk) > 0:
+        raise ValueError(
+            "Controlled TurboBoA evaluation requires full-vocabulary KL "
+            "(kl_topk <= 0)."
+        )
+
+    # Layer-streaming KL/PPL must run before Accelerate dispatches the model.
+    analyzer.model.cpu()
+    ppl, kl_raw = shared_eval_utils._kl_ppl_eval(
+        args,
+        analyzer,
+        reference.orig_lm_head,
+        reference.test_loader,
+        reference.ref_hidden,
+    )
+    metrics: dict[str, Any] = {
+        "wikitext2": {
+            "kl_raw": float(kl_raw),
+            "kl_x100": float(kl_raw) * 100.0,
+            "ppl": float(ppl),
+        },
+        "lm_eval": None,
+    }
+
+    if args.lm_eval:
+        shared_dist_utils.distribute_model(analyzer.model)
+        qa_results = shared_eval_utils.qa_eval(
+            analyzer.model,
+            analyzer.tokenizer,
+            args.lm_eval_batch_size,
+        )
+        expected = list(shared_eval_utils.PAPER_QA_TASKS)
+        actual = [name for name in qa_results if name != "acc_avg"]
+        if actual != expected or "acc_avg" not in qa_results:
+            raise RuntimeError(
+                "qa_eval returned a result outside the fixed ten-task paper "
+                f"protocol: expected={expected!r}, actual={actual!r}."
+            )
+        metrics["lm_eval"] = {
+            "tasks": {
+                name: float(qa_results[name])
+                for name in expected
+            },
+            "acc_avg": float(qa_results["acc_avg"]),
+        }
+    return metrics
+
+
+def _package_version(distribution: str) -> str | None:
+    try:
+        return importlib.metadata.version(distribution)
+    except importlib.metadata.PackageNotFoundError:
+        return None
+
+
+def _jsonable(value: Any) -> Any:
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, os.PathLike):
+        return os.fspath(value)
+    if isinstance(value, dict):
+        return {
+            str(key): _jsonable(item)
+            for key, item in value.items()
+        }
+    if isinstance(value, (list, tuple)):
+        return [_jsonable(item) for item in value]
+    if isinstance(value, type):
+        return f"{value.__module__}.{value.__qualname__}"
+    return str(value)
+
+
+def build_result_payload(
+    args,
+    *,
+    metrics: dict[str, Any] | None,
+    quantization_seconds: float,
+    total_seconds: float,
+    precompute_and_rotation_seconds: float | None = None,
+    algorithm_seconds: float | None = None,
+) -> dict[str, Any]:
+    config = {
+        key: _jsonable(value)
+        for key, value in vars(args).items()
+    }
+    runtime_seconds = {
+        "quantization": float(quantization_seconds),
+        "total": float(total_seconds),
+    }
+    gpu_hours = {}
+    if precompute_and_rotation_seconds is not None:
+        runtime_seconds["precompute_and_rotation"] = float(
+            precompute_and_rotation_seconds
+        )
+    if algorithm_seconds is not None:
+        runtime_seconds[
+            "algorithm_including_precompute_excluding_eval"
+        ] = float(algorithm_seconds)
+        # Controlled TurboBoA runs are single-GPU. This is deliberately
+        # sealed before evaluation, so lm-eval and KL/PPL are excluded.
+        gpu_hours[
+            "algorithm_including_precompute_excluding_eval"
+        ] = float(algorithm_seconds) / 3600.0
+
+    payload = {
+        "schema_version": 1,
+        "created_at": datetime.now(timezone.utc).isoformat(),
+        "method": "TurboBoA",
+        "status": "completed" if metrics is not None else "quantized_only",
+        "model": {
+            "path": args.llm_path,
+            "identity": args.model_identity,
+        },
+        "configuration": config,
+        "runtime_seconds": runtime_seconds,
+        "metrics": metrics,
+        "versions": {
+            "torch": _package_version("torch"),
+            "transformers": _package_version("transformers"),
+            "datasets": _package_version("datasets"),
+            "lm_eval": _package_version("lm-eval"),
+        },
+    }
+    if gpu_hours:
+        payload["gpu_hours"] = gpu_hours
+    return payload
+
+
+def atomic_write_json(path: str | os.PathLike, payload: dict[str, Any]) -> None:
+    """Atomically publish a strict JSON result on the target filesystem."""
+    destination = Path(path)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    fd, temporary = tempfile.mkstemp(
+        dir=destination.parent,
+        prefix=f".{destination.name}.",
+        suffix=".tmp",
+    )
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(
+                payload,
+                handle,
+                ensure_ascii=False,
+                indent=2,
+                sort_keys=True,
+                allow_nan=False,
+            )
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, destination)
+    finally:
+        try:
+            os.unlink(temporary)
+        except FileNotFoundError:
+            pass
