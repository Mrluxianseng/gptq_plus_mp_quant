+++ b/tests/test_realq_mse_adapter.py
@@ -0,0 +1,150 @@
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from turboBOA.quantize import build_weight_quantizer
+from turboBOA.quantizers.realq_mse import RealQMSEQuantizer
+from turboBOA.quantizers.turboboa import TurboBoA
+from turboBOA.quantizers.utils import reorder_col, reverse_reorder_col
+from utils.quant_utils import WeightQuantizer
+
+
+def _shared_quantizer(bits, group_size):
+    quantizer = WeightQuantizer()
+    quantizer.configure(
+        bits=bits,
+        perchannel=True,
+        sym=True,
+        mse=True,
+        norm=2.4,
+        grid=50,
+        maxshrink=0.5,
+        weight_groupsize=group_size,
+        w_group_param_layout="compact",
+    )
+    return quantizer
+
+
+@pytest.mark.parametrize("bits", [2, 3, 4])
+@pytest.mark.parametrize("group_size", [-1, 4])
+def test_adapter_is_byte_exact_shared_weight_quantizer(bits, group_size):
+    weight = torch.tensor(
+        [
+            [-2.3, -1.1, -0.7, 0.2, 0.4, 0.9, 1.8, 3.1],
+            [1.7, -2.8, 0.1, 0.5, -0.4, 2.2, -1.4, 0.8],
+            [0.0, 0.3, -0.6, 1.2, -1.8, 2.7, -3.4, 0.2],
+        ],
+        dtype=torch.float32,
+    )
+    shared = _shared_quantizer(bits, group_size)
+    shared.find_params(weight)
+
+    adapter = RealQMSEQuantizer()
+    adapter.configure(
+        bits,
+        per_channel=True,
+        group_size=group_size,
+        sym=True,
+        mse=True,
+    )
+    adapter.find_params(weight)
+
+    assert torch.equal(adapter.maxq, shared.maxq)
+    assert torch.equal(adapter.scale, shared.scale)
+    assert torch.equal(adapter.zero, shared.zero)
+
+    shared_qdq, shared_codes, _ = shared.fake_quantize(weight)
+    n_groups = 1 if group_size == -1 else weight.shape[1] // group_size
+    width = weight.shape[1] // n_groups
+    grouped_weight = weight.reshape(weight.shape[0], n_groups, width)
+    grouped_scale = adapter.scale.reshape(weight.shape[0], n_groups, 1)
+    grouped_zero = adapter.zero.reshape(weight.shape[0], n_groups, 1)
+    adapter_codes = adapter.quantize_int(
+        grouped_weight, grouped_scale, grouped_zero
+    )
+    adapter_qdq = adapter.fake_quantize_values(
+        grouped_weight, grouped_scale, grouped_zero
+    )
+    assert torch.equal(adapter_codes.reshape_as(weight), shared_codes)
+    assert torch.equal(adapter_qdq.reshape_as(weight), shared_qdq)
+    assert int(adapter_codes.min()) >= -(int(adapter.maxq) + 1)
+    assert int(adapter_codes.max()) <= int(adapter.maxq)
+
+
+def test_factory_observes_same_fp32_tensor_as_realq():
+    weight = torch.tensor(
+        [[-2.0, -0.2, 0.7, 1.4], [1.1, -0.8, 0.3, -1.7]],
+        dtype=torch.float16,
+    )
+    configs = {
+        "weight_quantizer": "realq_mse",
+        "w_bits": 3,
+        "group_size": 2,
+        "w_sym": True,
+    }
+    actual = build_weight_quantizer(configs, weight)
+    expected = _shared_quantizer(bits=3, group_size=2)
+    expected.find_params(weight.float())
+    assert torch.equal(actual.scale, expected.scale)
+    assert torch.equal(actual.zero, expected.zero)
+
+
+def test_global_act_order_keeps_natural_group_scale_membership():
+    first_head = torch.tensor(
+        [
+            [
+                [[0.20, 0.45], [1.20, 1.55], [-0.30, -0.75], [2.10, 2.60]],
+                [[-0.15, -0.55], [0.90, 1.40], [0.35, 0.80], [-2.20, -2.75]],
+            ]
+        ],
+        dtype=torch.float32,
+    )
+    # Multiple weight heads share one input Hessian/permutation (the Q/K
+    # projection shape); this exercises natural_columns expansion.
+    weight = torch.cat([first_head, -0.7 * first_head], dim=0)
+    hidden = weight.shape[-2] * weight.shape[-1]
+    # The descending order crosses every natural two-column group.
+    hessian = torch.diag(
+        torch.tensor([1.0, 8.0, 2.0, 7.0, 3.0, 6.0, 4.0, 5.0])
+    ).unsqueeze(0)
+    ordered_w, ordered_h, _, perm, invperm = reorder_col(
+        weight, hessian, None
+    )
+
+    quantizer = RealQMSEQuantizer()
+    quantizer.configure(
+        3, per_channel=True, group_size=2, sym=True, mse=True
+    )
+    quantizer.find_params(weight.reshape(4, hidden))
+    scale = quantizer.scale.reshape(2, 2, 4, 1)
+    zero = quantizer.zero.reshape(2, 2, 4, 1)
+
+    layer = torch.nn.Linear(hidden, 4, bias=False)
+    opts = {
+        "qparam_comput": "RealQ-MSE",
+        "adaptive_qparam": False,
+        "refine_qparam": False,
+        "n_iters": 1,
+        "consider_dX": False,
+        "alpha": 0.25,
+        "n_quant_rows": 2,
+        "act_order_col": True,
+        "act_order_row": False,
+    }
+    solver = TurboBoA(layer, opts, {"replace": 1 / 32})
+    solver.quantizer = quantizer
+    ordered_q, returned_scale, _ = solver.gptq(
+        ordered_w,
+        ordered_h,
+        torch.diag_embed(
+            torch.diagonal(ordered_h, dim1=-2, dim2=-1).rsqrt()
+        ),
+        None,
+        natural_columns=perm,
+        fixed_scale=scale,
+        fixed_zero=zero,
+    )
+    restored_q = reverse_reorder_col(ordered_q, invperm)
+    expected_q = quantizer.fake_quantize_values(weight, scale, zero)
+    assert torch.equal(returned_scale, scale)
+    assert torch.equal(restored_q, expected_q)
