+            getattr(
+                attention,
+                "_turboboa_post_rope_observers_installed",
+                False,
+            )
+        ):
+            continue
+        if hasattr(attention, "rot_out_Q") or hasattr(
+            attention, "rot_out_K"
+        ):
+            raise RuntimeError(
+                "Refusing an ambiguous partial TurboBoA observer install on "
+                f"Qwen3 block {index}."
+            )
+
+        func = attention.forward.__func__
+        # In 4W4A aware mode the shared QK helper has already replaced the
+        # decorated method with a raw copied function containing its wrapper.
+        # In 3W16A mode unwrap the deprecation decorator to reach the forward
+        # that directly calls apply_rotary_pos_emb.
+        if not hasattr(
+            attention,
+            "apply_rotary_pos_emb_qk_rotation_wrapper",
+        ):
+            while hasattr(func, "__wrapped__"):
+                func = func.__wrapped__
